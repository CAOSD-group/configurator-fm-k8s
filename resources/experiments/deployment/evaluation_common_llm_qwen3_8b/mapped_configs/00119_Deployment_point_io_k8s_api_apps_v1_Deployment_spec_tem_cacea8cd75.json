{
  "config": {
    "io_k8s_api_apps_v1_Deployment_apiVersion": "apps/v1",
    "io_k8s_api_apps_v1_Deployment_kind": "Deployment",
    "io_k8s_api_apps_v1_Deployment_metadata": {
      "io_k8s_api_apps_v1_Deployment_metadata_name": "vsphere-volume-deployment"
    },
    "io_k8s_api_apps_v1_Deployment_spec": {
      "io_k8s_api_apps_v1_Deployment_spec_replicas": 1,
      "io_k8s_api_apps_v1_Deployment_spec_selector": {
        "io_k8s_api_apps_v1_Deployment_spec_selector_matchLabels": [
          {
            "io_k8s_api_apps_v1_Deployment_spec_selector_matchLabels_KeyMap": "app",
            "io_k8s_api_apps_v1_Deployment_spec_selector_matchLabels_ValueMap": "vsphere-volume"
          }
        ]
      },
      "io_k8s_api_apps_v1_Deployment_spec_template": {
        "io_k8s_api_apps_v1_Deployment_spec_template_metadata": {
          "io_k8s_api_apps_v1_Deployment_spec_template_metadata_labels": [
            {
              "io_k8s_api_apps_v1_Deployment_spec_template_metadata_labels_KeyMap": "app",
              "io_k8s_api_apps_v1_Deployment_spec_template_metadata_labels_ValueMap": "vsphere-volume"
            }
          ]
        },
        "io_k8s_api_apps_v1_Deployment_spec_template_spec": {
          "io_k8s_api_apps_v1_Deployment_spec_template_spec_containers": [
            {
              "io_k8s_api_apps_v1_Deployment_spec_template_spec_containers_name": "app-container",
              "io_k8s_api_apps_v1_Deployment_spec_template_spec_containers_image": "nginx",
              "io_k8s_api_apps_v1_Deployment_spec_template_spec_containers_volumeMounts": [
                {
                  "io_k8s_api_apps_v1_Deployment_spec_template_spec_containers_volumeMounts_name": "vsphere-volume",
                  "io_k8s_api_apps_v1_Deployment_spec_template_spec_containers_volumeMounts_mountPath": "/mnt/vsphere"
                }
              ]
            }
          ],
          "io_k8s_api_apps_v1_Deployment_spec_template_spec_volumes": [
            {
              "io_k8s_api_apps_v1_Deployment_spec_template_spec_volumes_name": "vsphere-volume",
              "io_k8s_api_apps_v1_Deployment_spec_template_spec_volumes_vsphereVolume": {
                "io_k8s_api_apps_v1_Deployment_spec_template_spec_volumes_vsphereVolume_volumePath": "/vmfs/volumes/datastore1/my-volume",
                "io_k8s_api_apps_v1_Deployment_spec_template_spec_volumes_vsphereVolume_fsType": {
                  "io_k8s_api_apps_v1_Deployment_spec_template_spec_volumes_vsphereVolume_fsType_ext4": true
                }
              }
            }
          ]
        }
      }
    }
  }
}
