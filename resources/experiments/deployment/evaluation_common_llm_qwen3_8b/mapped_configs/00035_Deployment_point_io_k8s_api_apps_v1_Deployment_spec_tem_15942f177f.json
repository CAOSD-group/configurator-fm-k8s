                "io_k8s_api_apps_v1_Deployment_spec_template_spec_containers_securityContext_runAsGroup": {
                  "io_k8s_api_apps_v1_Deployment_spec_template_spec_containers_securityContext_runAsGroup_valueInt": 1000
