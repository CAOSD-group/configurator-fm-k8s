                      "io_k8s_api_apps_v1_Deployment_spec_template_spec_containers_livenessProbe_exec_command_StringValue": "-c"
                    },
                    {
                      "io_k8s_api_apps_v1_Deployment_spec_template_spec_containers_livenessProbe_exec_command_StringValue": "echo 'Liveness probe'; sleep 1"
