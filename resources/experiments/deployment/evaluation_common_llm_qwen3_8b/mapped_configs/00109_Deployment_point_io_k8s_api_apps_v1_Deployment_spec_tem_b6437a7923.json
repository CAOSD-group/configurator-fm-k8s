{
  "config": {
    "io_k8s_api_apps_v1_Deployment_apiVersion": "apps/v1",
    "io_k8s_api_apps_v1_Deployment_kind": "Deployment",
    "io_k8s_api_apps_v1_Deployment_metadata": {
      "io_k8s_api_apps_v1_Deployment_metadata_name": "iscsi-app"
    },
    "io_k8s_api_apps_v1_Deployment_spec": {
      "io_k8s_api_apps_v1_Deployment_spec_replicas": 1,
      "io_k8s_api_apps_v1_Deployment_spec_selector": {
        "io_k8s_api_apps_v1_Deployment_spec_selector_matchLabels": [
          {
            "io_k8s_api_apps_v1_Deployment_spec_selector_matchLabels_KeyMap": "app",
            "io_k8s_api_apps_v1_Deployment_spec_selector_matchLabels_ValueMap": "iscsi-app"
          }
        ]
      },
      "io_k8s_api_apps_v1_Deployment_spec_template": {
        "io_k8s_api_apps_v1_Deployment_spec_template_metadata": {
          "io_k8s_api_apps_v1_Deployment_spec_template_metadata_labels": [
            {
              "io_k8s_api_apps_v1_Deployment_spec_template_metadata_labels_KeyMap": "app",
              "io_k8s_api_apps_v1_Deployment_spec_template_metadata_labels_ValueMap": "iscsi-app"
            }
          ]
        },
        "io_k8s_api_apps_v1_Deployment_spec_template_spec": {
          "io_k8s_api_apps_v1_Deployment_spec_template_spec_containers": [
            {
              "io_k8s_api_apps_v1_Deployment_spec_template_spec_containers_name": "app-container",
              "io_k8s_api_apps_v1_Deployment_spec_template_spec_containers_image": "nginx",
              "io_k8s_api_apps_v1_Deployment_spec_template_spec_containers_volumeMounts": [
                {
                  "io_k8s_api_apps_v1_Deployment_spec_template_spec_containers_volumeMounts_name": "iscsi-volume",
                  "io_k8s_api_apps_v1_Deployment_spec_template_spec_containers_volumeMounts_mountPath": "/mnt/iscsi"
                }
              ]
            }
          ],
          "io_k8s_api_apps_v1_Deployment_spec_template_spec_volumes": [
            {
              "io_k8s_api_apps_v1_Deployment_spec_template_spec_volumes_name": "iscsi-volume",
              "io_k8s_api_apps_v1_Deployment_spec_template_spec_volumes_persistentVolumeClaim": {
                "io_k8s_api_apps_v1_Deployment_spec_template_spec_volumes_persistentVolumeClaim_claimName": "iscsi-pvc"
              }
            }
          ],
          "io_k8s_api_apps_v1_Deployment_spec_template_spec_initContainers": [
            {
              "io_k8s_api_apps_v1_Deployment_spec_template_spec_initContainers_name": "iscsi-init",
              "io_k8s_api_apps_v1_Deployment_spec_template_spec_initContainers_image": "busybox",
              "io_k8s_api_apps_v1_Deployment_spec_template_spec_initContainers_command": [
                {
                  "io_k8s_api_apps_v1_Deployment_spec_template_spec_initContainers_command_StringValue": "sh"
                },
                {
                  "io_k8s_api_apps_v1_Deployment_spec_template_spec_initContainers_command_StringValue": "-c"
                },
                {
                  "io_k8s_api_apps_v1_Deployment_spec_template_spec_initContainers_command_StringValue": "echo \"Setting up iSCSI volume...\"\nmount -t iscsi <iscsi-target>:/path /mnt/iscsi\n"
                }
              ]
            }
          ],
          "io_k8s_api_apps_v1_Deployment_spec_template_spec_nodeSelector": [
            {
              "io_k8s_api_apps_v1_Deployment_spec_template_spec_nodeSelector_KeyMap": "beta.kubernetes.io/os",
              "io_k8s_api_apps_v1_Deployment_spec_template_spec_nodeSelector_ValueMap": "linux"
            }
          ],
          "io_k8s_api_apps_v1_Deployment_spec_template_spec_tolerations": [
            {
              "io_k8s_api_apps_v1_Deployment_spec_template_spec_tolerations_key": "node-role.kubernetes.io/control-plane",
              "io_k8s_api_apps_v1_Deployment_spec_template_spec_tolerations_operator": {
                "io_k8s_api_apps_v1_Deployment_spec_template_spec_tolerations_operator_Exists": true
              },
              "io_k8s_api_apps_v1_Deployment_spec_template_spec_tolerations_effect": {
                "io_k8s_api_apps_v1_Deployment_spec_template_spec_tolerations_effect_NoSchedule": true
              }
            }
          ]
        }
      }
    }
  }
}
