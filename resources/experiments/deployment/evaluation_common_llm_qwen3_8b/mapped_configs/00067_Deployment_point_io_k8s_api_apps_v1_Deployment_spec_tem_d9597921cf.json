{
  "config": {
    "io_k8s_api_apps_v1_Deployment_apiVersion": "apps/v1",
    "io_k8s_api_apps_v1_Deployment_kind": "Deployment",
    "io_k8s_api_apps_v1_Deployment_metadata": {
      "io_k8s_api_apps_v1_Deployment_metadata_name": "liveness-probe-demo"
    },
    "io_k8s_api_apps_v1_Deployment_spec": {
      "io_k8s_api_apps_v1_Deployment_spec_replicas": 1,
      "io_k8s_api_apps_v1_Deployment_spec_selector": {
        "io_k8s_api_apps_v1_Deployment_spec_selector_matchLabels": [
          {
            "io_k8s_api_apps_v1_Deployment_spec_selector_matchLabels_KeyMap": "app",
            "io_k8s_api_apps_v1_Deployment_spec_selector_matchLabels_ValueMap": "liveness-probe-demo"
          }
        ]
      },
      "io_k8s_api_apps_v1_Deployment_spec_template": {
        "io_k8s_api_apps_v1_Deployment_spec_template_metadata": {
          "io_k8s_api_apps_v1_Deployment_spec_template_metadata_labels": [
            {
              "io_k8s_api_apps_v1_Deployment_spec_template_metadata_labels_KeyMap": "app",
              "io_k8s_api_apps_v1_Deployment_spec_template_metadata_labels_ValueMap": "liveness-probe-demo"
            }
          ]
        },
        "io_k8s_api_apps_v1_Deployment_spec_template_spec": {
          "io_k8s_api_apps_v1_Deployment_spec_template_spec_initContainers": [
            {
              "io_k8s_api_apps_v1_Deployment_spec_template_spec_initContainers_name": "init-container",
              "io_k8s_api_apps_v1_Deployment_spec_template_spec_initContainers_image": "busybox",
              "io_k8s_api_apps_v1_Deployment_spec_template_spec_initContainers_command": [
                {
                  "io_k8s_api_apps_v1_Deployment_spec_template_spec_initContainers_command_StringValue": "sh"
                },
                {
                  "io_k8s_api_apps_v1_Deployment_spec_template_spec_initContainers_command_StringValue": "-c"
                },
                {
                  "io_k8s_api_apps_v1_Deployment_spec_template_spec_initContainers_command_StringValue": "echo Initiating init container && sleep 30"
                }
              ],
              "io_k8s_api_apps_v1_Deployment_spec_template_spec_initContainers_lifecycle": {
                "io_k8s_api_apps_v1_Deployment_spec_template_spec_initContainers_lifecycle_preStop": {
                  "io_k8s_api_apps_v1_Deployment_spec_template_spec_initContainers_lifecycle_preStop_exec": {
                    "io_k8s_api_apps_v1_Deployment_spec_template_spec_initContainers_lifecycle_preStop_exec_command": [
                      {
                        "io_k8s_api_apps_v1_Deployment_spec_template_spec_initContainers_lifecycle_preStop_exec_command_StringValue": "sh"
                      },
                      {
                        "io_k8s_api_apps_v1_Deployment_spec_template_spec_initContainers_lifecycle_preStop_exec_command_StringValue": "-c"
                      },
                      {
                        "io_k8s_api_apps_v1_Deployment_spec_template_spec_initContainers_lifecycle_preStop_exec_command_StringValue": "echo Cleaning up init container"
                      }
                    ]
                  }
                }
              }
            }
          ],
          "io_k8s_api_apps_v1_Deployment_spec_template_spec_containers": [
            {
              "io_k8s_api_apps_v1_Deployment_spec_template_spec_containers_name": "main-container",
              "io_k8s_api_apps_v1_Deployment_spec_template_spec_containers_image": "nginx",
              "io_k8s_api_apps_v1_Deployment_spec_template_spec_containers_ports": [
                {
                  "io_k8s_api_apps_v1_Deployment_spec_template_spec_containers_ports_containerPort": 80
                }
              ],
              "io_k8s_api_apps_v1_Deployment_spec_template_spec_containers_livenessProbe": {
                "io_k8s_api_apps_v1_Deployment_spec_template_spec_containers_livenessProbe_httpGet": {
                  "io_k8s_api_apps_v1_Deployment_spec_template_spec_containers_livenessProbe_httpGet_path": "/",
                  "io_k8s_api_apps_v1_Deployment_spec_template_spec_containers_livenessProbe_httpGet_port": {
                    "io_k8s_api_apps_v1_Deployment_spec_template_spec_containers_livenessProbe_httpGet_port_asInteger": 80
                  }
                },
                "io_k8s_api_apps_v1_Deployment_spec_template_spec_containers_livenessProbe_initialDelaySeconds": 5,
                "io_k8s_api_apps_v1_Deployment_spec_template_spec_containers_livenessProbe_periodSeconds": 10
              }
            }
          ]
        }
      }
    }
  }
}
