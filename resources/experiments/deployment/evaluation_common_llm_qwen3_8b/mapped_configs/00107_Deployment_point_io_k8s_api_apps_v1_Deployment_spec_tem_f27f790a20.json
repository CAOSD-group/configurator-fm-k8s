{
  "config": {
    "io_k8s_api_apps_v1_Deployment_apiVersion": "apps/v1",
    "io_k8s_api_apps_v1_Deployment_kind": "Deployment",
    "io_k8s_api_apps_v1_Deployment_metadata": {
      "io_k8s_api_apps_v1_Deployment_metadata_name": "flexvolume-test"
    },
    "io_k8s_api_apps_v1_Deployment_spec": {
      "io_k8s_api_apps_v1_Deployment_spec_replicas": 1,
      "io_k8s_api_apps_v1_Deployment_spec_selector": {
        "io_k8s_api_apps_v1_Deployment_spec_selector_matchLabels": [
          {
            "io_k8s_api_apps_v1_Deployment_spec_selector_matchLabels_KeyMap": "app",
            "io_k8s_api_apps_v1_Deployment_spec_selector_matchLabels_ValueMap": "flexvolume-test"
          }
        ]
      },
      "io_k8s_api_apps_v1_Deployment_spec_template": {
        "io_k8s_api_apps_v1_Deployment_spec_template_metadata": {
          "io_k8s_api_apps_v1_Deployment_spec_template_metadata_labels": [
            {
              "io_k8s_api_apps_v1_Deployment_spec_template_metadata_labels_KeyMap": "app",
              "io_k8s_api_apps_v1_Deployment_spec_template_metadata_labels_ValueMap": "flexvolume-test"
            }
          ]
        },
        "io_k8s_api_apps_v1_Deployment_spec_template_spec": {
          "io_k8s_api_apps_v1_Deployment_spec_template_spec_containers": [
            {
              "io_k8s_api_apps_v1_Deployment_spec_template_spec_containers_name": "test-container",
              "io_k8s_api_apps_v1_Deployment_spec_template_spec_containers_image": "busybox",
              "io_k8s_api_apps_v1_Deployment_spec_template_spec_containers_command": [
                {
                  "io_k8s_api_apps_v1_Deployment_spec_template_spec_containers_command_StringValue": "sh"
                },
                {
                  "io_k8s_api_apps_v1_Deployment_spec_template_spec_containers_command_StringValue": "-c"
                },
                {
                  "io_k8s_api_apps_v1_Deployment_spec_template_spec_containers_command_StringValue": "echo \"Testing FlexVolume\" && sleep 3600"
                }
              ],
              "io_k8s_api_apps_v1_Deployment_spec_template_spec_containers_volumeMounts": [
                {
                  "io_k8s_api_apps_v1_Deployment_spec_template_spec_containers_volumeMounts_name": "flexvol",
                  "io_k8s_api_apps_v1_Deployment_spec_template_spec_containers_volumeMounts_mountPath": "/mnt/flexvol"
                }
              ]
            }
          ],
          "io_k8s_api_apps_v1_Deployment_spec_template_spec_volumes": [
            {
              "io_k8s_api_apps_v1_Deployment_spec_template_spec_volumes_name": "flexvol",
              "io_k8s_api_apps_v1_Deployment_spec_template_spec_volumes_flexVolume": {
                "io_k8s_api_apps_v1_Deployment_spec_template_spec_volumes_flexVolume_driver": "example.com/flexvolume",
                "io_k8s_api_apps_v1_Deployment_spec_template_spec_volumes_flexVolume_fsType": {
                  "io_k8s_api_apps_v1_Deployment_spec_template_spec_volumes_flexVolume_fsType_ext4": true
                }
              }
            }
          ]
        }
      }
    }
  }
}
