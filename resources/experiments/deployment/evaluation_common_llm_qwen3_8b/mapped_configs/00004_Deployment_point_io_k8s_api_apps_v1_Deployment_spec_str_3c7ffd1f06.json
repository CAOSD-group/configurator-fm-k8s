          "io_k8s_api_apps_v1_Deployment_spec_strategy_rollingUpdate_maxUnavailable": {
            "io_k8s_api_apps_v1_Deployment_spec_strategy_rollingUpdate_maxUnavailable_asInteger": 0
          }
