															io_k8s_api_resource_v1_ResourceClaim_status_allocation_nodeSelector_nodeSelectorTerms_matchExpressions_operator {doc 'Represents a key_s relationship to a set of values Valid operators are In, NotIn, Exists, DoesNotExist Gt, and Lt'}
																alternative
