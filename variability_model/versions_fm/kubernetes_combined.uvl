											io_k8s_api_apps_v1_ReplicaSetSpec_template_spec_volumes_portworxVolume {doc 'portworxVolume represents a portworx volume attached and mounted on kubelets host machine Deprecated: PortworxVolume is deprecated All operations for the in-tree portworxVolume type are redirected to the pxdportworxcom CSI driver'}
