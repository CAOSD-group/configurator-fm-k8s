											String io_k8s_api_apps_v1_DeploymentSpec_template_spec_ephemeralContainers_restartPolicy {doc 'Restart policy for the container to manage the restart behavior of each container within a pod You cannot set this field on ephemeral containers'}
											io_k8s_api_apps_v1_DeploymentSpec_template_spec_ephemeralContainers_restartPolicyRules cardinality [1..*] {doc 'Represents a list of rules to be checked to determine if the container should be restarted on exit You cannot set this field on ephemeral containers'}
												mandatory
