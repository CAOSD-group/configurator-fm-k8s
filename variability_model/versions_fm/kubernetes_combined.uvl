									io_k8s_api_resource_v1beta1_ResourceClaim_status_allocation_nodeSelector {doc 'NodeSelector defines where the allocated resources are available If unset, they are available everywhere'}
										mandatory
											io_k8s_api_resource_v1beta1_ResourceClaim_status_allocation_nodeSelector_nodeSelectorTerms cardinality [1..*] {doc 'Required A list of node selector terms The terms are ORed'}
