											io_k8s_api_batch_v1_JobSpec_template_spec_volumes_gitRepo {doc 'gitRepo represents a git repository at a particular revision Deprecated: GitRepo is deprecated To provision a container with a git repo, mount an EmptyDir into an InitContainer that clones the repo using git, then mount the EmptyDir into the Pod_s container'}
												mandatory
