											io_k8s_api_core_v1_PodTemplate_template_spec_ephemeralContainers_restartPolicyRules cardinality [1..*] {doc 'Represents a list of rules to be checked to determine if the container should be restarted on exit You cannot set this field on ephemeral containers'}
