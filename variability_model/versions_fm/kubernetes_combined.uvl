							io_k8s_api_core_v1_PodSpec_volumes_storageos {doc 'storageOS represents a StorageOS volume attached and mounted on Kubernetes nodes Deprecated: StorageOS is deprecated and the in-tree storageos type is no longer supported'}
								optional
									io_k8s_api_core_v1_PodSpec_volumes_storageos_fsType {doc 'fsType is the filesystem type to mount Must be a filesystem type supported by the host operating system Ex ext4, xfs, ntfs Implicitly inferred to be ext4 if unspecified'}
