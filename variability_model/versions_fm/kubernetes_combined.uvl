																alternative
																	io_k8s_api_batch_v1_Job_spec_template_spec_volumes_storageos_fsType_ntfs {doc 'Specific value: ntfs'}
																	io_k8s_api_batch_v1_Job_spec_template_spec_volumes_storageos_fsType_xfs {doc 'Specific value: xfs'}
