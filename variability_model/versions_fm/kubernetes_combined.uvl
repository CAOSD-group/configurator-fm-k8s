			io_k8s_api_core_v1_NodeAllocatableMappedResources {doc 'NodeAllocatableMappedResources describes mapped node allocatable resource allocations'}
				mandatory
					String io_k8s_api_core_v1_NodeAllocatableMappedResources_name {doc 'Name is the name of the resource (eg, cpu, memory)'}
					io_k8s_api_core_v1_NodeAllocatableMappedResources_quantity {doc 'Quantity is the total node allocatable resource capacity allocated for the claim This claim_s allocated devices is shared by all the containers referencing the claim Kubelet adds this value to both requests and limits at the pod-level cgroup, and to limits at the container-level cgroup for each container referencing the claim'}
						alternative
							String io_k8s_api_core_v1_NodeAllocatableMappedResources_quantity_asString {doc 'Sub-feature added of type String'}
							Integer io_k8s_api_core_v1_NodeAllocatableMappedResources_quantity_asNumber {doc 'Sub-feature added of type Number'}
			io_k8s_api_core_v1_NodeAllocatableOverheadResources {doc 'NodeAllocatableOverheadResources describes auxiliary overhead resource allocations'}
				mandatory
					String io_k8s_api_core_v1_NodeAllocatableOverheadResources_name {doc 'Name is the name of the resource (eg, cpu, memory)'}
				optional
					io_k8s_api_core_v1_NodeAllocatableOverheadResources_perContainer {doc 'PerContainer is the variable overhead quantity applied for each container referencing the claim The container references are recorded in nodeAllocatableResourceClaimStatusescontainers The total overhead quantity allocated for the claim is computed as: Quantity = PerPod + (PerContainer * NumReferences) Kubelet accounts for this overhead in cgroups: - Pod-level cgroup (requests and limits): Kubelet adds PerPod + (PerContainer * NumReferences) - Container-level cgroup (limits only): Kubelet adds PerPod + PerContainer for each referencing container This allows any single container to access the pod-level overhead, while the parent cgroup caps the total usage to account for PerPod exactly once At least one of PerPod or PerContainer must be specified Specifying neither is an invalid configuration'}
						alternative
							String io_k8s_api_core_v1_NodeAllocatableOverheadResources_perContainer_asString {doc 'Sub-feature added of type String'}
							Integer io_k8s_api_core_v1_NodeAllocatableOverheadResources_perContainer_asNumber {doc 'Sub-feature added of type Number'}
					io_k8s_api_core_v1_NodeAllocatableOverheadResources_perPod {doc 'PerPod is the flat overhead quantity allocated per pod Adding to each container limit allows individual containers to utilize the overhead, while the parent pod-level cgroup limit caps the total usage at the pod boundary where the overhead is accounted for exactly once At least one of PerPod or PerContainer must be specified Specifying neither is an invalid configuration'}
						alternative
							String io_k8s_api_core_v1_NodeAllocatableOverheadResources_perPod_asString {doc 'Sub-feature added of type String'}
							Integer io_k8s_api_core_v1_NodeAllocatableOverheadResources_perPod_asNumber {doc 'Sub-feature added of type Number'}
			io_k8s_api_core_v1_NodeAllocatableResourceClaimStatus {doc 'NodeAllocatableResourceClaimStatus describes the status of node allocatable resources allocated via DRA'}
				mandatory
					String io_k8s_api_core_v1_NodeAllocatableResourceClaimStatus_resourceClaimName {doc 'ResourceClaimName is the resource claim referenced by the pod that resulted in this node allocatable resource allocation'}
				optional
