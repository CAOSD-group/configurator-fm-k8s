								mandatory
									String io_k8s_api_core_v1_EnvVar_valueFrom_fileKeyRef_key {doc 'The key within the env file An invalid key will prevent the pod from starting The keys defined within a source may consist of any printable ASCII characters except _=_ During Alpha stage of the EnvFiles feature gate, the key size is limited to 128 characters'}
									String io_k8s_api_core_v1_EnvVar_valueFrom_fileKeyRef_path {doc 'The path within the volume from which to select the file Must be relative and may not contain the __ path or start with __'}
