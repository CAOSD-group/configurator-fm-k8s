																			io_k8s_api_apps_v1_DeploymentList_items_spec_template_spec_volumes_photonPersistentDisk_fsType_ext4 {default, doc 'Specific value: ext4'}
															io_k8s_api_apps_v1_DeploymentList_items_spec_template_spec_volumes_portworxVolume {doc 'portworxVolume represents a portworx volume attached and mounted on kubelets host machine Deprecated: PortworxVolume is deprecated All operations for the in-tree portworxVolume type are redirected to the pxdportworxcom CSI driver'}
																mandatory
