															Integer io_k8s_api_core_v1_PodTemplate_template_spec_volumes_secret_items_user {doc 'user is Optional: The owner UID of the created file If specified, the item-level user field takes precedence over defaultUser (Alpha) This field requires the AtomicWriteVolumeUserFields feature gate to be enabled'}
													io_k8s_api_core_v1_PodTemplate_template_spec_volumes_secret_optional {doc 'optional field specify whether the Secret or its keys must be defined'}
													String io_k8s_api_core_v1_PodTemplate_template_spec_volumes_secret_secretName {doc 'secretName is the name of the secret in the pod_s namespace to use More info: https:_kubernetesio/docs/concepts/storage/volumes#secret'}
											io_k8s_api_core_v1_PodTemplate_template_spec_volumes_storageos {doc 'storageOS represents a StorageOS volume attached and mounted on Kubernetes nodes Deprecated: StorageOS is deprecated and the in-tree storageos type is no longer supported'}
												optional
