											io_k8s_api_apps_v1_StatefulSetSpec_template_spec_volumes_cephfs {doc 'cephFS represents a Ceph FS mount on the host that shares a pod_s lifetime Deprecated: CephFS is deprecated and the in-tree cephfs type is no longer supported'}
