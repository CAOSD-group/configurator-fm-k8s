				mandatory
					Integer io_k8s_api_scheduling_v1alpha3_CompositeGangSchedulingPolicy_minGroupCount {doc 'minGroupCount is the minimum number of child groups that must be schedulable or scheduled at the same time for the scheduler to admit the entire group It must be a positive integer'}
			io_k8s_api_scheduling_v1alpha3_CompositePodGroup {doc 'CompositePodGroup represents a runtime instance of pod groups grouped together CompositePodGroups are created by workload controllers (LWS, JobSet, etc) from WorkloadcompositePodGroupTemplates CompositePodGroup API enablement is toggled by the CompositePodGroup feature gate'}
				mandatory
					io_k8s_api_scheduling_v1alpha3_CompositePodGroup_spec {doc 'spec defines the desired state of the CompositePodGroup'}
						mandatory
							io_k8s_api_scheduling_v1alpha3_CompositePodGroup_spec_schedulingPolicy {doc 'schedulingPolicy defines the scheduling policy for this instance of the CompositePodGroup Controllers are expected to fill this field by copying it from a CompositePodGroupTemplate This field is immutable'}
								optional
									io_k8s_api_scheduling_v1alpha3_CompositePodGroup_spec_schedulingPolicy_basic {doc 'basic specifies that the groups of this composite group should be scheduled independently This field is immutable'}
										optional
											io_k8s_api_scheduling_v1alpha3_CompositePodGroup_spec_schedulingPolicy_basic_CompositeBasicSchedulingPolicy {doc 'CompositeBasicSchedulingPolicy indicates that the groups belonging to the composite group should be scheduled independently'}
									io_k8s_api_scheduling_v1alpha3_CompositePodGroup_spec_schedulingPolicy_gang {doc 'gang specifies that the groups of this composite group should be scheduled using all-or-nothing semantics'}
										mandatory
											Integer io_k8s_api_scheduling_v1alpha3_CompositePodGroup_spec_schedulingPolicy_gang_minGroupCount {doc 'minGroupCount is the minimum number of child groups that must be schedulable or scheduled at the same time for the scheduler to admit the entire group It must be a positive integer'}
							io_k8s_api_scheduling_v1alpha3_CompositePodGroup_spec_workloadRef {doc 'workloadRef references an optional CompositePodGroup template within the Workload object that was used to create the CompositePodGroup This field is required This field is immutable'}
								mandatory
									String io_k8s_api_scheduling_v1alpha3_CompositePodGroup_spec_workloadRef_templateName {doc 'templateName is the name of a template within the Workload object that was used to create a pod group It must be a DNS label This field is required'}
									String io_k8s_api_scheduling_v1alpha3_CompositePodGroup_spec_workloadRef_workloadName {doc 'workloadName is the name of the Workload object that contains a template that was used when creating a pod group It must be a DNS name This field is required'}
						optional
							io_k8s_api_scheduling_v1alpha3_CompositePodGroup_spec_disruptionMode {doc 'disruptionMode defines the mode in which a given CompositePodGroup can be disrupted Controllers are expected to fill this field by copying it from a CompositePodGroupTemplate One of Single, All Defaults to Single if unset This field is immutable'}
								optional
									io_k8s_api_scheduling_v1alpha3_CompositePodGroup_spec_disruptionMode_all {doc 'all specifies that all children groups can only be disrupted together'}
										optional
											io_k8s_api_scheduling_v1alpha3_CompositePodGroup_spec_disruptionMode_all_AllCompositeDisruptionMode {doc 'AllCompositeDisruptionMode means that children of a CompositePodGroup can only be disrupted or preempted together'}
									io_k8s_api_scheduling_v1alpha3_CompositePodGroup_spec_disruptionMode_single {doc 'single specifies that children groups can be disrupted independently from each other'}
										optional
											io_k8s_api_scheduling_v1alpha3_CompositePodGroup_spec_disruptionMode_single_SingleCompositeDisruptionMode {doc 'SingleCompositeDisruptionMode means that individual children of a CompositePodGroup can be disrupted or preempted independently'}
								alternative
									io_k8s_api_scheduling_v1alpha3_CompositePodGroup_spec_disruptionMode_All {doc 'Specific value: All'}
									io_k8s_api_scheduling_v1alpha3_CompositePodGroup_spec_disruptionMode_Single {doc 'Specific value: Single'}
							String io_k8s_api_scheduling_v1alpha3_CompositePodGroup_spec_parentCompositePodGroupName {doc 'parentCompositePodGroupName contains the name of the parent composite pod group within the same namespace as this composite pod group It must be a DNS name If it_s nil, then this composite pod group is a root of a workload_s hierarchy This field is immutable'}
							io_k8s_api_scheduling_v1alpha3_CompositePodGroup_spec_preemptionPolicy {doc 'preemptionPolicy is the Policy for preempting pods/podgroups with lower priority One of Never, PreemptLowerPriority Defaults to PreemptLowerPriority if unset When Priority Admission Controller is enabled, it populates this field from PriorityClassName, and defaults to PreemptLowerPriority if value is unset in PriorityClass This field is immutable This field is available only when the PodGroupPreemptionPolicy feature gate is enabled'}
								alternative
									io_k8s_api_scheduling_v1alpha3_CompositePodGroup_spec_preemptionPolicy_PreemptLowerPriority {doc 'Specific value: PreemptLowerPriority'}
									io_k8s_api_scheduling_v1alpha3_CompositePodGroup_spec_preemptionPolicy_Never {doc 'Specific value: Never'}
							Integer io_k8s_api_scheduling_v1alpha3_CompositePodGroup_spec_priority {doc 'priority is the value of priority of this composite pod group Various system components use this field to find the priority of the composite pod group When Priority Admission Controller is enabled, it prevents users from setting this field The admission controller populates this field from PriorityClassName The higher the value, the higher the priority This field is immutable'}
							String io_k8s_api_scheduling_v1alpha3_CompositePodGroup_spec_priorityClassName {doc 'priorityClassName defines the priority that should be considered when scheduling this CompositePodGroup Controllers are expected to fill this field by copying it from a CompositePodGroupTemplate If left unspecified, it is validated and resolved similarly to the PriorityClassName field in Pods (ie if no priority class is specified, admission control can set this to the global default priority class if it exists Otherwise, the composite pod group_s priority will be zero) This field is immutable'}
							io_k8s_api_scheduling_v1alpha3_CompositePodGroup_spec_schedulingConstraints {doc 'schedulingConstraints defines optional scheduling constraints (eg topology) for this CompositePodGroup Controllers are expected to fill this field by copying it from a CompositePodGroupTemplate This field is immutable'}
								optional
									io_k8s_api_scheduling_v1alpha3_CompositePodGroup_spec_schedulingConstraints_topology cardinality [1..*] {doc 'topology defines the topology constraints for the composite pod group Currently only a single topology constraint can be specified This may change in the future'}
										mandatory
											String io_k8s_api_scheduling_v1alpha3_CompositePodGroup_spec_schedulingConstraints_topology_key {doc 'key specifies the key of the node label representing the topology domain All pods within the PodGroup must be colocated within the same domain instance Different PodGroups can land on different domain instances even if they derive from the same PodGroupTemplate Examples: topologykubernetesio/rack'}
				optional
					String io_k8s_api_scheduling_v1alpha3_CompositePodGroup_apiVersion {doc 'APIVersion defines the versioned schema of this representation of an object Servers should convert recognized schemas to the latest internal value, and may reject unrecognized values More info: https:_gitk8sio/community/contributors/devel/sig-architecture/api-conventionsmd#resources'}
