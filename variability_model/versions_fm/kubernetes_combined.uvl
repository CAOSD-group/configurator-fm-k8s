																									io_k8s_api_apps_v1_StatefulSetList_items_spec_template_spec_affinity_nodeAffinity_preferredDuringSchedulingIgnoredDuringExecution_preference_matchFields_operator_NotIn {doc 'Specific value: NotIn'}
