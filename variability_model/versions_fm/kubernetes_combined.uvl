																alternative
																	io_k8s_api_resource_v1beta1_ResourceSliceSpec_devices_basic_nodeSelector_nodeSelectorTerms_matchExpressions_operator_Lt {doc 'Specific value: Lt'}
																	io_k8s_api_resource_v1beta1_ResourceSliceSpec_devices_basic_nodeSelector_nodeSelectorTerms_matchExpressions_operator_DoesNotExist {doc 'Specific value: DoesNotExist'}
																	io_k8s_api_resource_v1beta1_ResourceSliceSpec_devices_basic_nodeSelector_nodeSelectorTerms_matchExpressions_operator_Exists {doc 'Specific value: Exists'}
																	io_k8s_api_resource_v1beta1_ResourceSliceSpec_devices_basic_nodeSelector_nodeSelectorTerms_matchExpressions_operator_Gt {doc 'Specific value: Gt'}
																	io_k8s_api_resource_v1beta1_ResourceSliceSpec_devices_basic_nodeSelector_nodeSelectorTerms_matchExpressions_operator_In {doc 'Specific value: In'}
																	io_k8s_api_resource_v1beta1_ResourceSliceSpec_devices_basic_nodeSelector_nodeSelectorTerms_matchExpressions_operator_NotIn {doc 'Specific value: NotIn'}
														optional
															io_k8s_api_resource_v1beta1_ResourceSliceSpec_devices_basic_nodeSelector_nodeSelectorTerms_matchExpressions_values cardinality [1..*] {doc 'An array of string values If the operator is In or NotIn, the values array must be non-empty If the operator is Exists or DoesNotExist, the values array must be empty If the operator is Gt or Lt, the values array must have a single element, which will be interpreted as an integer This array is replaced during a strategic merge patch'}
																mandatory
																	String io_k8s_api_resource_v1beta1_ResourceSliceSpec_devices_basic_nodeSelector_nodeSelectorTerms_matchExpressions_values_StringValue {doc 'Added String mandatory for complete structure Array in the model The modified is not in json but provide represents, Array of Strings: StringValue'}
													io_k8s_api_resource_v1beta1_ResourceSliceSpec_devices_basic_nodeSelector_nodeSelectorTerms_matchFields cardinality [1..*] {doc 'A list of node selector requirements by node_s fields'}
														mandatory
