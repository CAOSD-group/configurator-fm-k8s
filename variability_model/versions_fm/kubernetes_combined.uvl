										mandatory
											String io_k8s_api_scheduling_v1beta1_PodGroup_spec_schedulingConstraints_topology_key {doc 'key specifies the key of the node label representing the topology domain All pods within the PodGroup must be colocated within the same domain instance Different PodGroups can land on different domain instances even if they derive from the same PodGroupTemplate Examples: topologykubernetesio/rack'}
