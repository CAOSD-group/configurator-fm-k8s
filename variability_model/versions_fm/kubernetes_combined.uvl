																			io_k8s_api_apps_v1_ReplicaSet_spec_template_spec_containers_env_valueFrom_fileKeyRef_optional {doc 'Specify whether the file or its key must be defined If the file or key does not exist, then the env var is not published If optional is set to true and the specified key does not exist, the environment variable will not be set in the Pod_s containersIf optional is set to false and the specified key does not exist, an error will be returned during Pod creation'}
