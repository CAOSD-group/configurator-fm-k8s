															io_k8s_api_apps_v1_ReplicaSetList_items_spec_template_spec_initContainers_resizePolicy cardinality [1..*] {doc 'Resources resize policy for the container This field cannot be set on ephemeral containers'}
																mandatory
																	io_k8s_api_apps_v1_ReplicaSetList_items_spec_template_spec_initContainers_resizePolicy_resourceName {doc 'Name of the resource to which this resource resize policy applies Supported values: cpu, memory'}
