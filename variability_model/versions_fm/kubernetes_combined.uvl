											io_k8s_api_authorization_v1_SelfSubjectAccessReviewSpec_resourceAttributes_labelSelector_requirements_operator {doc 'operator represents a key_s relationship to a set of values Valid operators are In, NotIn, Exists and DoesNotExist'}
												alternative
													io_k8s_api_authorization_v1_SelfSubjectAccessReviewSpec_resourceAttributes_labelSelector_requirements_operator_In {doc 'Specific value: In'}
