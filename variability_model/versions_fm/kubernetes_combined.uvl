											io_k8s_api_resource_v1beta2_ResourceSlice_spec_nodeSelector_nodeSelectorTerms_matchFields cardinality [1..*] {doc 'A list of node selector requirements by node_s fields'}
												mandatory
													String io_k8s_api_resource_v1beta2_ResourceSlice_spec_nodeSelector_nodeSelectorTerms_matchFields_key {doc 'The label key that the selector applies to'}
