										alternative
											io_k8s_api_batch_v1_CronJob_metadata_managedFields_operation_Apply {doc 'Specific value: Apply'}
											io_k8s_api_batch_v1_CronJob_metadata_managedFields_operation_Update {doc 'Specific value: Update'}
