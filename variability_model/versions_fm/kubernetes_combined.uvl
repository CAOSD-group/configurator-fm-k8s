															io_k8s_api_apps_v1_StatefulSet_spec_template_spec_ephemeralContainers_resources_claims cardinality [1..*] {doc 'Claims lists the names of resources, defined in specresourceClaims, that are used by this containerThis field depends on the DynamicResourceAllocation feature gateThis field is immutable It can only be set for containers'}
																mandatory
																	String io_k8s_api_apps_v1_StatefulSet_spec_template_spec_ephemeralContainers_resources_claims_name {doc 'Name must match the name of one entry in podspecresourceClaims of the Pod where this field is used It makes that resource available inside a container'}
