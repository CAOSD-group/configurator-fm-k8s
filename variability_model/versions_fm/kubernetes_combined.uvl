											io_k8s_api_apps_v1_DeploymentSpec_template_spec_volumes_flexVolume {doc 'flexVolume represents a generic volume resource that is provisioned/attached using an exec based plugin Deprecated: FlexVolume is deprecated Consider using a CSIDriver instead'}
