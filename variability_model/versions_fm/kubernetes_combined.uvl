											Integer io_k8s_api_core_v1_PodSpec_volumes_secret_items_user {doc 'user is Optional: The owner UID of the created file If specified, the item-level user field takes precedence over defaultUser (Alpha) This field requires the AtomicWriteVolumeUserFields feature gate to be enabled'}
									io_k8s_api_core_v1_PodSpec_volumes_secret_optional {doc 'optional field specify whether the Secret or its keys must be defined'}
