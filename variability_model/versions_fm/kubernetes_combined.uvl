																	String io_k8s_api_batch_v1_Job_spec_template_spec_containers_readinessProbe_httpGet_protocol {doc 'Protocol selects the wire protocol for the probe connection Nil defaults to HTTP/11'}
																	String io_k8s_api_batch_v1_Job_spec_template_spec_containers_readinessProbe_httpGet_scheme {doc 'Scheme to use for connecting to the host Defaults to HTTP'}
