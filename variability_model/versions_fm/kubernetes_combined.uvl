			io_k8s_api_core_v1_PodCertificateProjection {doc 'PodCertificateProjection provides a private key and X509 certificate in the pod filesystem'}
				mandatory
					io_k8s_api_core_v1_PodCertificateProjection_keyType {doc 'The type of keypair Kubelet will generate for the podValid values are RSA3072, RSA4096, ECDSAP256, ECDSAP384, ECDSAP521, and ED25519'}
