									io_k8s_api_core_v1_Pod_spec_volumes_photonPersistentDisk {doc 'photonPersistentDisk represents a PhotonController persistent disk attached and mounted on kubelets host machine Deprecated: PhotonPersistentDisk is deprecated and the in-tree photonPersistentDisk type is no longer supported'}
