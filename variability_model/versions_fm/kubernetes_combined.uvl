											io_k8s_api_admissionregistration_v1alpha1_MutatingAdmissionPolicyBinding_spec_matchResources_resourceRules_operations cardinality [1..*] {doc 'operations is the operations the admission hook cares about - CREATE, UPDATE, DELETE, CONNECT or * for all of those operations and any future admission operations that are added If _*_ is present, the length of the slice must be one Required'}
												mandatory
