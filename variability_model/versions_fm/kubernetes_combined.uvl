							Integer io_k8s_apiextensions_apiserver_pkg_apis_apiextensions_v1_JSONSchemaProps_allOf_minLength
							Integer io_k8s_apiextensions_apiserver_pkg_apis_apiextensions_v1_JSONSchemaProps_allOf_minProperties
