													String io_k8s_api_core_v1_PodTemplateSpec_spec_containers_livenessProbe_httpGet_protocol {doc 'Protocol selects the wire protocol for the probe connection Nil defaults to HTTP/11'}
													String io_k8s_api_core_v1_PodTemplateSpec_spec_containers_livenessProbe_httpGet_scheme {doc 'Scheme to use for connecting to the host Defaults to HTTP'}
