											io_k8s_api_core_v1_PodList_items_spec_volumes_portworxVolume {doc 'portworxVolume represents a portworx volume attached and mounted on kubelets host machine Deprecated: PortworxVolume is deprecated All operations for the in-tree portworxVolume type are redirected to the pxdportworxcom CSI driver'}
