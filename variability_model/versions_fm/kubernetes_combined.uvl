													io_k8s_api_core_v1_ReplicationController_spec_template_spec_volumes_rbd {doc 'rbd represents a Rados Block Device mount on the host that shares a pod_s lifetime Deprecated: RBD is deprecated and the in-tree rbd type is no longer supported'}
