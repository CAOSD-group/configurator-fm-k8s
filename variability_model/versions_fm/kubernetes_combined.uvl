					io_k8s_api_resource_v1alpha3_ResourcePoolStatusRequestStatus_pools cardinality [1..*] {doc 'Pools contains the first speclimit matching pools, sorted by driver then pool name If len(pools) < poolCount, the list was truncated When omitted, no pools matched the request filters'}
						mandatory
							String io_k8s_api_resource_v1alpha3_ResourcePoolStatusRequestStatus_pools_driver {doc 'Driver is the DRA driver name for this pool Must be a DNS subdomain (eg, gpuexamplecom)'}
							Integer io_k8s_api_resource_v1alpha3_ResourcePoolStatusRequestStatus_pools_generation {doc 'Generation is the pool generation observed across all ResourceSlices in this pool Only the latest generation is reported During a generation rollout, if not all slices at the latest generation have been published, the pool is included with a validationError and device counts unset'}
							String io_k8s_api_resource_v1alpha3_ResourcePoolStatusRequestStatus_pools_poolName {doc 'PoolName is the name of the pool Must be a valid resource pool name (DNS subdomains separated by /)'}
						optional
							Integer io_k8s_api_resource_v1alpha3_ResourcePoolStatusRequestStatus_pools_allocatedDevices {doc 'AllocatedDevices is the number of devices currently allocated to claims A value of 0 means no devices are allocated May be unset when validationError is set'}
							Integer io_k8s_api_resource_v1alpha3_ResourcePoolStatusRequestStatus_pools_availableDevices {doc 'AvailableDevices is the number of devices available for allocation This equals TotalDevices - AllocatedDevices - UnavailableDevices A value of 0 means no devices are currently available May be unset when validationError is set'}
							String io_k8s_api_resource_v1alpha3_ResourcePoolStatusRequestStatus_pools_nodeName {doc 'NodeName is the node this pool is associated with When omitted, the pool is not associated with a specific node Must be a valid DNS subdomain name (RFC1123)'}
							io_k8s_api_resource_v1alpha3_ResourcePoolStatusRequestStatus_pools_partitionSummary cardinality [1..*] {doc 'PartitionSummary reports allocatability per (attribute, partition type) for a partitionable pool that publishes SharedCounters Each entry names the grouping attribute it was resolved from: the PartitionTypeAttribute declared by a device_s own slice, or for devices whose slice declares none, the default named in the request A pool that mixes partitions declared under different attributes reports each independently When no slice declares an attribute and the request names no default, the pool reports no partition summary'}
								mandatory
									Integer io_k8s_api_resource_v1alpha3_ResourcePoolStatusRequestStatus_pools_partitionSummary_allocatable {doc 'Allocatable is the number of additional devices of this partition type that could still be allocated given current shared-counter consumption'}
									String io_k8s_api_resource_v1alpha3_ResourcePoolStatusRequestStatus_pools_partitionSummary_attribute {doc 'Attribute is the fully qualified name of the device attribute whose value groups this entry It is the PartitionTypeAttribute declared by the devices_ own slice, or the default named in the request when their slice declares none'}
									Integer io_k8s_api_resource_v1alpha3_ResourcePoolStatusRequestStatus_pools_partitionSummary_total {doc 'Total is the number of devices of this partition type in the pool'}
									String io_k8s_api_resource_v1alpha3_ResourcePoolStatusRequestStatus_pools_partitionSummary_type {doc 'Type is the partition type value (eg Full or Half)'}
							Integer io_k8s_api_resource_v1alpha3_ResourcePoolStatusRequestStatus_pools_resourceSliceCount {doc 'ResourceSliceCount is the number of ResourceSlices that make up this pool May be unset when validationError is set'}
							io_k8s_api_resource_v1alpha3_ResourcePoolStatusRequestStatus_pools_shareableSummary {doc 'ShareableSummary reports aggregate capacity for a pool that contains devices with AllowMultipleAllocations It is populated only when at least one device in the pool is shareable'}
								mandatory
									Integer io_k8s_api_resource_v1alpha3_ResourcePoolStatusRequestStatus_pools_shareableSummary_fullyAvailableDevices {doc 'FullyAvailableDevices is the number of shareable devices with no capacity consumed'}
									Integer io_k8s_api_resource_v1alpha3_ResourcePoolStatusRequestStatus_pools_shareableSummary_partiallyAvailableDevices {doc 'PartiallyAvailableDevices is the number of shareable devices with some but not all capacity consumed'}
								optional
									io_k8s_api_resource_v1alpha3_ResourcePoolStatusRequestStatus_pools_shareableSummary_capacity cardinality [1..*] {doc 'Capacity reports aggregate total, consumed, and available amounts per shareable capacity key across the pool'}
										mandatory
											io_k8s_api_resource_v1alpha3_ResourcePoolStatusRequestStatus_pools_shareableSummary_capacity_available {doc 'Available is Total minus Consumed, never negative'}
												alternative
													String io_k8s_api_resource_v1alpha3_ResourcePoolStatusRequestStatus_pools_shareableSummary_capacity_available_asString {doc 'Sub-feature added of type String'}
													Integer io_k8s_api_resource_v1alpha3_ResourcePoolStatusRequestStatus_pools_shareableSummary_capacity_available_asNumber {doc 'Sub-feature added of type Number'}
											io_k8s_api_resource_v1alpha3_ResourcePoolStatusRequestStatus_pools_shareableSummary_capacity_consumed {doc 'Consumed is the amount drawn by current allocations'}
												alternative
													String io_k8s_api_resource_v1alpha3_ResourcePoolStatusRequestStatus_pools_shareableSummary_capacity_consumed_asString {doc 'Sub-feature added of type String'}
													Integer io_k8s_api_resource_v1alpha3_ResourcePoolStatusRequestStatus_pools_shareableSummary_capacity_consumed_asNumber {doc 'Sub-feature added of type Number'}
											String io_k8s_api_resource_v1alpha3_ResourcePoolStatusRequestStatus_pools_shareableSummary_capacity_name {doc 'Name is the capacity name'}
											io_k8s_api_resource_v1alpha3_ResourcePoolStatusRequestStatus_pools_shareableSummary_capacity_total {doc 'Total is the sum of this capacity across shareable devices in the pool'}
												alternative
													String io_k8s_api_resource_v1alpha3_ResourcePoolStatusRequestStatus_pools_shareableSummary_capacity_total_asString {doc 'Sub-feature added of type String'}
													Integer io_k8s_api_resource_v1alpha3_ResourcePoolStatusRequestStatus_pools_shareableSummary_capacity_total_asNumber {doc 'Sub-feature added of type Number'}
							Integer io_k8s_api_resource_v1alpha3_ResourcePoolStatusRequestStatus_pools_totalDevices {doc 'TotalDevices is the total number of devices in the pool across all slices A value of 0 means the pool has no devices May be unset when validationError is set'}
							Integer io_k8s_api_resource_v1alpha3_ResourcePoolStatusRequestStatus_pools_unavailableDevices {doc 'UnavailableDevices is the number of devices that are not available due to taints or other conditions, but are not allocated A value of 0 means all unallocated devices are available May be unset when validationError is set'}
							String io_k8s_api_resource_v1alpha3_ResourcePoolStatusRequestStatus_pools_validationError {doc 'ValidationError is set when the pool_s data could not be fully validated (eg, incomplete slice publication) When set, device count fields and ResourceSliceCount may be unset'}
			io_k8s_api_resource_v1alpha3_ShareableCapacityStatus {doc 'ShareableCapacityStatus reports aggregate amounts for a single shareable capacity key'}
				mandatory
					io_k8s_api_resource_v1alpha3_ShareableCapacityStatus_available {doc 'Available is Total minus Consumed, never negative'}
						alternative
							String io_k8s_api_resource_v1alpha3_ShareableCapacityStatus_available_asString {doc 'Sub-feature added of type String'}
							Integer io_k8s_api_resource_v1alpha3_ShareableCapacityStatus_available_asNumber {doc 'Sub-feature added of type Number'}
					io_k8s_api_resource_v1alpha3_ShareableCapacityStatus_consumed {doc 'Consumed is the amount drawn by current allocations'}
						alternative
							String io_k8s_api_resource_v1alpha3_ShareableCapacityStatus_consumed_asString {doc 'Sub-feature added of type String'}
							Integer io_k8s_api_resource_v1alpha3_ShareableCapacityStatus_consumed_asNumber {doc 'Sub-feature added of type Number'}
					String io_k8s_api_resource_v1alpha3_ShareableCapacityStatus_name {doc 'Name is the capacity name'}
					io_k8s_api_resource_v1alpha3_ShareableCapacityStatus_total {doc 'Total is the sum of this capacity across shareable devices in the pool'}
						alternative
							String io_k8s_api_resource_v1alpha3_ShareableCapacityStatus_total_asString {doc 'Sub-feature added of type String'}
							Integer io_k8s_api_resource_v1alpha3_ShareableCapacityStatus_total_asNumber {doc 'Sub-feature added of type Number'}
			io_k8s_api_resource_v1alpha3_ShareableSummaryStatus {doc 'ShareableSummaryStatus reports aggregate capacity for a pool that contains devices with AllowMultipleAllocations'}
				mandatory
					Integer io_k8s_api_resource_v1alpha3_ShareableSummaryStatus_fullyAvailableDevices {doc 'FullyAvailableDevices is the number of shareable devices with no capacity consumed'}
					Integer io_k8s_api_resource_v1alpha3_ShareableSummaryStatus_partiallyAvailableDevices {doc 'PartiallyAvailableDevices is the number of shareable devices with some but not all capacity consumed'}
				optional
					io_k8s_api_resource_v1alpha3_ShareableSummaryStatus_capacity cardinality [1..*] {doc 'Capacity reports aggregate total, consumed, and available amounts per shareable capacity key across the pool'}
						mandatory
							io_k8s_api_resource_v1alpha3_ShareableSummaryStatus_capacity_available {doc 'Available is Total minus Consumed, never negative'}
								alternative
									String io_k8s_api_resource_v1alpha3_ShareableSummaryStatus_capacity_available_asString {doc 'Sub-feature added of type String'}
									Integer io_k8s_api_resource_v1alpha3_ShareableSummaryStatus_capacity_available_asNumber {doc 'Sub-feature added of type Number'}
							io_k8s_api_resource_v1alpha3_ShareableSummaryStatus_capacity_consumed {doc 'Consumed is the amount drawn by current allocations'}
								alternative
									String io_k8s_api_resource_v1alpha3_ShareableSummaryStatus_capacity_consumed_asString {doc 'Sub-feature added of type String'}
									Integer io_k8s_api_resource_v1alpha3_ShareableSummaryStatus_capacity_consumed_asNumber {doc 'Sub-feature added of type Number'}
							String io_k8s_api_resource_v1alpha3_ShareableSummaryStatus_capacity_name {doc 'Name is the capacity name'}
							io_k8s_api_resource_v1alpha3_ShareableSummaryStatus_capacity_total {doc 'Total is the sum of this capacity across shareable devices in the pool'}
								alternative
									String io_k8s_api_resource_v1alpha3_ShareableSummaryStatus_capacity_total_asString {doc 'Sub-feature added of type String'}
									Integer io_k8s_api_resource_v1alpha3_ShareableSummaryStatus_capacity_total_asNumber {doc 'Sub-feature added of type Number'}
			io_k8s_api_resource_v1beta1_AllocatedDeviceStatus {doc 'AllocatedDeviceStatus contains the status of an allocated device, if the driver chooses to report it This may include driver-specific informationThe combination of Driver, Pool, Device, and ShareID must match the corresponding key in StatusAllocationDevices'}
				mandatory
					String io_k8s_api_resource_v1beta1_AllocatedDeviceStatus_device {doc 'Device references one device instance via its name in the driver_s resource pool It must be a DNS label'}
					String io_k8s_api_resource_v1beta1_AllocatedDeviceStatus_driver {doc 'Driver specifies the name of the DRA driver whose kubelet plugin should be invoked to process the allocation once the claim is needed on a nodeMust be a DNS subdomain and should end with a DNS domain owned by the vendor of the driver It should use only lower case characters'}
					String io_k8s_api_resource_v1beta1_AllocatedDeviceStatus_pool {doc 'This name together with the driver name and the device name field identify which device was allocated (<driver name>/<pool name>/<device name>)Must not be longer than 253 characters and may contain one or more DNS sub-domains separated by slashes'}
				optional
					io_k8s_api_resource_v1beta1_AllocatedDeviceStatus_conditions cardinality [1..*] {doc 'Conditions contains the latest observation of the device_s state If the device has been configured according to the class and claim config references, the Ready condition should be TrueMust not contain more than 8 entries'}
						mandatory
							io_k8s_api_resource_v1beta1_AllocatedDeviceStatus_conditions_lastTransitionTime {doc 'lastTransitionTime is the last time the condition transitioned from one status to another This should be when the underlying condition changed  If that is not known, then using the time when the API field changed is acceptable'}
								optional
									String io_k8s_api_resource_v1beta1_AllocatedDeviceStatus_conditions_lastTransitionTime_Time {doc 'Time is a wrapper around timeTime which supports correct marshaling to YAML and JSON  Wrappers are provided for many of the factory methods that the time package offers'}
							String io_k8s_api_resource_v1beta1_AllocatedDeviceStatus_conditions_message {doc 'message is a human readable message indicating details about the transition This may be an empty string'}
							String io_k8s_api_resource_v1beta1_AllocatedDeviceStatus_conditions_reason {doc 'reason contains a programmatic identifier indicating the reason for the condition_s last transition Producers of specific condition types may define expected values and meanings for this field, and whether the values are considered a guaranteed API The value should be a CamelCase string This field may not be empty'}
							io_k8s_api_resource_v1beta1_AllocatedDeviceStatus_conditions_status {doc 'status of the condition, one of True, False, Unknown'}
								alternative
									io_k8s_api_resource_v1beta1_AllocatedDeviceStatus_conditions_status_Unknown {doc 'Specific value: Unknown'}
									io_k8s_api_resource_v1beta1_AllocatedDeviceStatus_conditions_status_True {doc 'Specific value: True'}
									io_k8s_api_resource_v1beta1_AllocatedDeviceStatus_conditions_status_False {doc 'Specific value: False'}
							String io_k8s_api_resource_v1beta1_AllocatedDeviceStatus_conditions_type {doc 'type of condition in CamelCase or in fooexamplecom/CamelCase'}
						optional
							Integer io_k8s_api_resource_v1beta1_AllocatedDeviceStatus_conditions_observedGeneration {doc 'observedGeneration represents the metadatageneration that the condition was set based upon For instance, if metadatageneration is currently 12, but the statusconditions[x]observedGeneration is 9, the condition is out of date with respect to the current state of the instance'}
					io_k8s_api_resource_v1beta1_AllocatedDeviceStatus_data {doc 'Data contains arbitrary driver-specific dataThe length of the raw data must be smaller or equal to 10 Ki'}
						optional
							io_k8s_api_resource_v1beta1_AllocatedDeviceStatus_data_RawExtension {doc 'RawExtension is used to hold extensions in external versionsTo use this, make a field which has RawExtension as its type in your external, versioned struct, and Object in your internal struct You also need to register your various plugin types_ Internal package:	type MyAPIObject struct 		runtimeTypeMeta json:		MyPlugin runtimeObject json:myPlugin		type PluginA struct 		AOption string json:aOption	_ External package:	type MyAPIObject struct 		runtimeTypeMeta json:		MyPlugin runtimeRawExtension json:myPlugin		type PluginA struct 		AOption string json:aOption	_ On the wire, the JSON will look something like this:			kind:MyAPIObject,		apiVersion:v1,		myPlugin: 			kind:PluginA,			aOption:foo,		,	So what happens? Decode first uses json or yaml to unmarshal the serialized data into your external MyAPIObject That causes the raw JSON to be stored, but not unpacked The next step is to copy (using pkg/conversion) into the internal struct The runtime package_s DefaultScheme has conversion functions installed which will unpack the JSON stored in RawExtension, turning it into the correct object type, and storing it in the Object (TODO: In the case where the object is of an unknown type, a runtimeUnknown object will be created and stored)'}
					io_k8s_api_resource_v1beta1_AllocatedDeviceStatus_networkData {doc 'NetworkData contains network-related information specific to the device'}
						optional
							String io_k8s_api_resource_v1beta1_AllocatedDeviceStatus_networkData_hardwareAddress {doc 'HardwareAddress represents the hardware address (eg MAC Address) of the device_s network interfaceMust not be longer than 128 bytes'}
							String io_k8s_api_resource_v1beta1_AllocatedDeviceStatus_networkData_interfaceName {doc 'InterfaceName specifies the name of the network interface associated with the allocated device This might be the name of a physical or virtual network interface being configured in the podMust not be longer than 256 bytes'}
							io_k8s_api_resource_v1beta1_AllocatedDeviceStatus_networkData_ips cardinality [1..*] {doc 'IPs lists the network addresses assigned to the device_s network interface This can include both IPv4 and IPv6 addresses The IPs are in the CIDR notation, which includes both the address and the associated subnet mask eg: 192025/24 for IPv4 and 2001:db8::5/64 for IPv6Must not contain more than 16 entries'}
								mandatory
									String io_k8s_api_resource_v1beta1_AllocatedDeviceStatus_networkData_ips_StringValue {doc 'Added String mandatory for complete structure Array in the model The modified is not in json but provide represents, Array of Strings: StringValue'}
					String io_k8s_api_resource_v1beta1_AllocatedDeviceStatus_shareID {doc 'ShareID uniquely identifies an individual allocation share of the device'}
			io_k8s_api_resource_v1beta1_AllocationResult {doc 'AllocationResult contains attributes of an allocated resource'}
				optional
					io_k8s_api_resource_v1beta1_AllocationResult_allocationTimestamp {doc 'AllocationTimestamp stores the time when the resources were allocated This field is not guaranteed to be set, in which case that time is unknownThis is a beta field and requires enabling the DRADeviceBindingConditions and DRAResourceClaimDeviceStatus feature gate'}
						optional
							String io_k8s_api_resource_v1beta1_AllocationResult_allocationTimestamp_Time {doc 'Time is a wrapper around timeTime which supports correct marshaling to YAML and JSON  Wrappers are provided for many of the factory methods that the time package offers'}
					io_k8s_api_resource_v1beta1_AllocationResult_devices {doc 'Devices is the result of allocating devices'}
						optional
							io_k8s_api_resource_v1beta1_AllocationResult_devices_config cardinality [1..*] {doc 'This field is a combination of all the claim and class configuration parameters Drivers can distinguish between those based on a flagThis includes configuration parameters for drivers which have no allocated devices in the result because it is up to the drivers which configuration parameters they support They can silently ignore unknown configuration parameters'}
								mandatory
									String io_k8s_api_resource_v1beta1_AllocationResult_devices_config_source {doc 'Source records whether the configuration comes from a class and thus is not something that a normal user would have been able to set or from a claim'}
								optional
									io_k8s_api_resource_v1beta1_AllocationResult_devices_config_opaque {doc 'Opaque provides driver-specific configuration parameters'}
										mandatory
											String io_k8s_api_resource_v1beta1_AllocationResult_devices_config_opaque_driver {doc 'Driver is used to determine which kubelet plugin needs to be passed these configuration parametersAn admission policy provided by the driver developer could use this to decide whether it needs to validate themMust be a DNS subdomain and should end with a DNS domain owned by the vendor of the driver It should use only lower case characters'}
											io_k8s_api_resource_v1beta1_AllocationResult_devices_config_opaque_parameters {doc 'Parameters can contain arbitrary data It is the responsibility of the driver developer to handle validation and versioning Typically this includes self-identification and a version (kind + apiVersion for Kubernetes types), with conversion between different versionsThe length of the raw data must be smaller or equal to 10 Ki'}
												optional
													io_k8s_api_resource_v1beta1_AllocationResult_devices_config_opaque_parameters_RawExtension {doc 'RawExtension is used to hold extensions in external versionsTo use this, make a field which has RawExtension as its type in your external, versioned struct, and Object in your internal struct You also need to register your various plugin types_ Internal package:	type MyAPIObject struct 		runtimeTypeMeta json:		MyPlugin runtimeObject json:myPlugin		type PluginA struct 		AOption string json:aOption	_ External package:	type MyAPIObject struct 		runtimeTypeMeta json:		MyPlugin runtimeRawExtension json:myPlugin		type PluginA struct 		AOption string json:aOption	_ On the wire, the JSON will look something like this:			kind:MyAPIObject,		apiVersion:v1,		myPlugin: 			kind:PluginA,			aOption:foo,		,	So what happens? Decode first uses json or yaml to unmarshal the serialized data into your external MyAPIObject That causes the raw JSON to be stored, but not unpacked The next step is to copy (using pkg/conversion) into the internal struct The runtime package_s DefaultScheme has conversion functions installed which will unpack the JSON stored in RawExtension, turning it into the correct object type, and storing it in the Object (TODO: In the case where the object is of an unknown type, a runtimeUnknown object will be created and stored)'}
									io_k8s_api_resource_v1beta1_AllocationResult_devices_config_requests cardinality [1..*] {doc 'Requests lists the names of requests where the configuration applies If empty, its applies to all requestsReferences to subrequests must include the name of the main request and may include the subrequest using the format <main request>[/<subrequest>] If just the main request is given, the configuration applies to all subrequests'}
										mandatory
											String io_k8s_api_resource_v1beta1_AllocationResult_devices_config_requests_StringValue {doc 'Added String mandatory for complete structure Array in the model The modified is not in json but provide represents, Array of Strings: StringValue'}
							io_k8s_api_resource_v1beta1_AllocationResult_devices_results cardinality [1..*] {doc 'Results lists all allocated devices'}
								mandatory
									String io_k8s_api_resource_v1beta1_AllocationResult_devices_results_device {doc 'Device references one device instance via its name in the driver_s resource pool It must be a DNS label'}
									String io_k8s_api_resource_v1beta1_AllocationResult_devices_results_driver {doc 'Driver specifies the name of the DRA driver whose kubelet plugin should be invoked to process the allocation once the claim is needed on a nodeMust be a DNS subdomain and should end with a DNS domain owned by the vendor of the driver It should use only lower case characters'}
									String io_k8s_api_resource_v1beta1_AllocationResult_devices_results_pool {doc 'This name together with the driver name and the device name field identify which device was allocated (<driver name>/<pool name>/<device name>)Must not be longer than 253 characters and may contain one or more DNS sub-domains separated by slashes'}
									String io_k8s_api_resource_v1beta1_AllocationResult_devices_results_request {doc 'Request is the name of the request in the claim which caused this device to be allocated If it references a subrequest in the firstAvailable list on a DeviceRequest, this field must include both the name of the main request and the subrequest using the format <main request>/<subrequest>Multiple devices may have been allocated per request'}
								optional
									io_k8s_api_resource_v1beta1_AllocationResult_devices_results_adminAccess {doc 'AdminAccess indicates that this device was allocated for administrative access See the corresponding request field for a definition of modeThis is an alpha field and requires enabling the DRAAdminAccess feature gate Admin access is disabled if this field is unset or set to false, otherwise it is enabled'}
									io_k8s_api_resource_v1beta1_AllocationResult_devices_results_bindingConditions cardinality [1..*] {doc 'BindingConditions contains a copy of the BindingConditions from the corresponding ResourceSlice at the time of allocationThis is a beta field and requires enabling the DRADeviceBindingConditions and DRAResourceClaimDeviceStatus feature gates'}
										mandatory
											String io_k8s_api_resource_v1beta1_AllocationResult_devices_results_bindingConditions_StringValue {doc 'Added String mandatory for complete structure Array in the model The modified is not in json but provide represents, Array of Strings: StringValue'}
									io_k8s_api_resource_v1beta1_AllocationResult_devices_results_bindingFailureConditions cardinality [1..*] {doc 'BindingFailureConditions contains a copy of the BindingFailureConditions from the corresponding ResourceSlice at the time of allocationThis is a beta field and requires enabling the DRADeviceBindingConditions and DRAResourceClaimDeviceStatus feature gates'}
										mandatory
											String io_k8s_api_resource_v1beta1_AllocationResult_devices_results_bindingFailureConditions_StringValue {doc 'Added String mandatory for complete structure Array in the model The modified is not in json but provide represents, Array of Strings: StringValue'}
									io_k8s_api_resource_v1beta1_AllocationResult_devices_results_consumedCapacity cardinality [1..*] {doc 'ConsumedCapacity tracks the amount of capacity consumed per device as part of the claim request The consumed amount may differ from the requested amount: it is rounded up to the nearest valid value based on the devices requestPolicy if applicable (ie, may not be less than the requested amount)The total consumed capacity for each device must not exceed the DeviceCapacity_s ValueThis field is populated only for devices that allow multiple allocations All capacity entries are included, even if the consumed amount is zero'}
										alternative
											String io_k8s_api_resource_v1beta1_AllocationResult_devices_results_consumedCapacity_asString {doc 'Sub-feature added of type String'}
											Integer io_k8s_api_resource_v1beta1_AllocationResult_devices_results_consumedCapacity_asNumber {doc 'Sub-feature added of type Number'}
									String io_k8s_api_resource_v1beta1_AllocationResult_devices_results_shareID {doc 'ShareID uniquely identifies an individual allocation share of the device, used when the device supports multiple simultaneous allocations It serves as an additional map key to differentiate concurrent shares of the same device'}
									io_k8s_api_resource_v1beta1_AllocationResult_devices_results_skipNodeOperations cardinality [1..*] {doc 'SkipNodeOperations lists node-local resource operations (gRPC calls) that will be skipped for this allocated device when determining whether operations are necessary on the node If all allocated devices for a driver in a claim skip an operation, that gRPC call will be skipped It is a copy of the ResourceSlicespecskipNodeOperations value at the time when the device was allocated'}
										mandatory
											String io_k8s_api_resource_v1beta1_AllocationResult_devices_results_skipNodeOperations_StringValue {doc 'Added String mandatory for complete structure Array in the model The modified is not in json but provide represents, Array of Strings: StringValue'}
									io_k8s_api_resource_v1beta1_AllocationResult_devices_results_tolerations cardinality [1..*] {doc 'A copy of all tolerations specified in the request at the time when the device got allocatedThe maximum number of tolerations is 16This is a beta field and requires enabling the DRADeviceTaints feature gate'}
										optional
											io_k8s_api_resource_v1beta1_AllocationResult_devices_results_tolerations_effect {doc 'Effect indicates the taint effect to match Empty means match all taint effects When specified, allowed values are NoSchedule and NoExecute'}
												alternative
													io_k8s_api_resource_v1beta1_AllocationResult_devices_results_tolerations_effect_NoExecute {doc 'Specific value: NoExecute'}
													io_k8s_api_resource_v1beta1_AllocationResult_devices_results_tolerations_effect_NoSchedule {doc 'Specific value: NoSchedule'}
											String io_k8s_api_resource_v1beta1_AllocationResult_devices_results_tolerations_key {doc 'Key is the taint key that the toleration applies to Empty means match all taint keys If the key is empty, operator must be Exists; this combination means to match all values and all keys Must be a label name'}
											io_k8s_api_resource_v1beta1_AllocationResult_devices_results_tolerations_operator {doc 'Operator represents a key_s relationship to the value Valid operators are Exists and Equal Defaults to Equal Exists is equivalent to wildcard for value, so that a ResourceClaim can tolerate all taints of a particular category'}
												alternative
													io_k8s_api_resource_v1beta1_AllocationResult_devices_results_tolerations_operator_Equal {default, doc 'Specific value: Equal'}
													io_k8s_api_resource_v1beta1_AllocationResult_devices_results_tolerations_operator_Exists {doc 'Specific value: Exists'}
											Integer io_k8s_api_resource_v1beta1_AllocationResult_devices_results_tolerations_tolerationSeconds {doc 'TolerationSeconds represents the period of time the toleration (which must be of effect NoExecute, otherwise this field is ignored) tolerates the taint By default, it is not set, which means tolerate the taint forever (do not evict) Zero and negative values will be treated as 0 (evict immediately) by the system If larger than zero, the time when the pod needs to be evicted is calculated as <time when taint was adedd> + <toleration seconds>'}
											io_k8s_api_resource_v1beta1_AllocationResult_devices_results_tolerations_value {abstract, doc 'Value is the taint value the toleration matches to If the operator is Exists, the value must be empty, otherwise just a regular string Must be a label value'}
												mandatory
