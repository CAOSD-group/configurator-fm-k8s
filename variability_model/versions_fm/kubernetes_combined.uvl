																			io_k8s_api_batch_v1_CronJobList_items_spec_jobTemplate_spec_template_spec_volumes_gcePersistentDisk {doc 'gcePersistentDisk represents a GCE Disk resource that is attached to a kubelet_s host machine and then exposed to the pod Deprecated: GCEPersistentDisk is deprecated All operations for the in-tree gcePersistentDisk type are redirected to the pdcsistoragegkeio CSI driver More info: https:_kubernetesio/docs/concepts/storage/volumes#gcepersistentdisk'}
																				mandatory
