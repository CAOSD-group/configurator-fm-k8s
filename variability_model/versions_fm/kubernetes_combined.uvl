							io_k8s_api_core_v1_Node_status_declaredFeatures cardinality [1..*] {doc 'DeclaredFeatures represents the features related to feature gates that are declared by the node'}
								mandatory
									String io_k8s_api_core_v1_Node_status_declaredFeatures_StringValue {doc 'Added String mandatory for complete structure Array in the model The modified is not in json but provide represents, Array of Strings: StringValue'}
