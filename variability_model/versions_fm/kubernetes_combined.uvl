													io_k8s_api_scheduling_v1alpha3_CompositePodGroupList_items_spec_disruptionMode_single_SingleCompositeDisruptionMode {doc 'SingleCompositeDisruptionMode means that individual children of a CompositePodGroup can be disrupted or preempted independently'}
										alternative
											io_k8s_api_scheduling_v1alpha3_CompositePodGroupList_items_spec_disruptionMode_All {doc 'Specific value: All'}
											io_k8s_api_scheduling_v1alpha3_CompositePodGroupList_items_spec_disruptionMode_Single {doc 'Specific value: Single'}
									String io_k8s_api_scheduling_v1alpha3_CompositePodGroupList_items_spec_parentCompositePodGroupName {doc 'parentCompositePodGroupName contains the name of the parent composite pod group within the same namespace as this composite pod group It must be a DNS name If it_s nil, then this composite pod group is a root of a workload_s hierarchy This field is immutable'}
									io_k8s_api_scheduling_v1alpha3_CompositePodGroupList_items_spec_preemptionPolicy {doc 'preemptionPolicy is the Policy for preempting pods/podgroups with lower priority One of Never, PreemptLowerPriority Defaults to PreemptLowerPriority if unset When Priority Admission Controller is enabled, it populates this field from PriorityClassName, and defaults to PreemptLowerPriority if value is unset in PriorityClass This field is immutable This field is available only when the PodGroupPreemptionPolicy feature gate is enabled'}
										alternative
											io_k8s_api_scheduling_v1alpha3_CompositePodGroupList_items_spec_preemptionPolicy_PreemptLowerPriority {doc 'Specific value: PreemptLowerPriority'}
											io_k8s_api_scheduling_v1alpha3_CompositePodGroupList_items_spec_preemptionPolicy_Never {doc 'Specific value: Never'}
									Integer io_k8s_api_scheduling_v1alpha3_CompositePodGroupList_items_spec_priority {doc 'priority is the value of priority of this composite pod group Various system components use this field to find the priority of the composite pod group When Priority Admission Controller is enabled, it prevents users from setting this field The admission controller populates this field from PriorityClassName The higher the value, the higher the priority This field is immutable'}
									String io_k8s_api_scheduling_v1alpha3_CompositePodGroupList_items_spec_priorityClassName {doc 'priorityClassName defines the priority that should be considered when scheduling this CompositePodGroup Controllers are expected to fill this field by copying it from a CompositePodGroupTemplate If left unspecified, it is validated and resolved similarly to the PriorityClassName field in Pods (ie if no priority class is specified, admission control can set this to the global default priority class if it exists Otherwise, the composite pod group_s priority will be zero) This field is immutable'}
									io_k8s_api_scheduling_v1alpha3_CompositePodGroupList_items_spec_schedulingConstraints {doc 'schedulingConstraints defines optional scheduling constraints (eg topology) for this CompositePodGroup Controllers are expected to fill this field by copying it from a CompositePodGroupTemplate This field is immutable'}
										optional
											io_k8s_api_scheduling_v1alpha3_CompositePodGroupList_items_spec_schedulingConstraints_topology cardinality [1..*] {doc 'topology defines the topology constraints for the composite pod group Currently only a single topology constraint can be specified This may change in the future'}
												mandatory
													String io_k8s_api_scheduling_v1alpha3_CompositePodGroupList_items_spec_schedulingConstraints_topology_key {doc 'key specifies the key of the node label representing the topology domain All pods within the PodGroup must be colocated within the same domain instance Different PodGroups can land on different domain instances even if they derive from the same PodGroupTemplate Examples: topologykubernetesio/rack'}
						optional
							String io_k8s_api_scheduling_v1alpha3_CompositePodGroupList_items_apiVersion {doc 'APIVersion defines the versioned schema of this representation of an object Servers should convert recognized schemas to the latest internal value, and may reject unrecognized values More info: https:_gitk8sio/community/contributors/devel/sig-architecture/api-conventionsmd#resources'}
