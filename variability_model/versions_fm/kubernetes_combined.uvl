																optional
																	String io_k8s_api_apps_v1_ReplicaSet_spec_template_spec_ephemeralContainers_readinessProbe_grpc_mode {doc 'mode specifies the connection mode for the gRPC health probe Set to TLS to use TLS without certificate verification Set to Plaintext to use a plaintext (insecure) connection explicitly If not specified, the probe uses a plaintext (insecure) connection'}
																	String io_k8s_api_apps_v1_ReplicaSet_spec_template_spec_ephemeralContainers_readinessProbe_grpc_service {doc 'Service is the name of the service to place in the gRPC HealthCheckRequest (see https:_githubcom/grpc/grpc/blob/master/doc/health-checkingmd)If this is not specified, the default behavior is defined by gRPC'}
