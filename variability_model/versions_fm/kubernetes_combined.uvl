									io_k8s_api_authorization_v1_LabelSelectorAttributes_requirements_operator_DoesNotExist {doc 'Specific value: DoesNotExist'}
									io_k8s_api_authorization_v1_LabelSelectorAttributes_requirements_operator_Exists {doc 'Specific value: Exists'}
						optional
