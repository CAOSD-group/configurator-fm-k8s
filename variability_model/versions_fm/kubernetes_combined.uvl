																mandatory
																	String io_k8s_api_resource_v1_ResourceSlice_spec_devices_nodeSelector_nodeSelectorTerms_matchExpressions_values_StringValue {doc 'Added String mandatory for complete structure Array in the model The modified is not in json but provide represents, Array of Strings: StringValue'}
													io_k8s_api_resource_v1_ResourceSlice_spec_devices_nodeSelector_nodeSelectorTerms_matchFields cardinality [1..*] {doc 'A list of node selector requirements by node_s fields'}
														mandatory
