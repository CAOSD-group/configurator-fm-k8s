						optional
							io_k8s_api_scheduling_v1alpha3_WorkloadSpec_compositePodGroupTemplates_disruptionMode {doc 'disruptionMode defines the mode in which a given CompositePodGroup can be disrupted One of Single, All This field is immutable'}
								optional
