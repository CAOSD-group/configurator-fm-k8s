									String io_k8s_api_apps_v1_StatefulSetSpec_volumeClaimTemplates_status_currentVolumeAttributesClassName {doc 'currentVolumeAttributesClassName is the current name of the VolumeAttributesClass the PVC is using When unset, there is no VolumeAttributeClass applied to this PersistentVolumeClaim'}
									io_k8s_api_apps_v1_StatefulSetSpec_volumeClaimTemplates_status_healthStatus {doc 'healthStatus contains the latest controller-reported health information for the volume bound to this claim'}
										optional
