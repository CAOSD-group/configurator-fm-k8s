																			io_k8s_api_batch_v1_JobTemplateSpec_spec_template_spec_affinity_podAffinity_preferredDuringSchedulingIgnoredDuringExecution_podAffinityTerm_matchLabelKeys cardinality [1..*] {doc 'MatchLabelKeys is a set of pod label keys to select which pods will be taken into consideration The keys are used to lookup values from the incoming pod labels, those key-value labels are merged with labelSelector as key in (value) to select the group of existing pods which pods will be taken into consideration for the incoming pod_s pod (anti) affinity Keys that don_t exist in the incoming pod labels will be ignored The default value is empty The same key is forbidden to exist in both matchLabelKeys and labelSelector Also, matchLabelKeys cannot be set when labelSelector isn_t set'}
																				mandatory
																					String io_k8s_api_batch_v1_JobTemplateSpec_spec_template_spec_affinity_podAffinity_preferredDuringSchedulingIgnoredDuringExecution_podAffinityTerm_matchLabelKeys_StringValue {doc 'Added String mandatory for complete structure Array in the model The modified is not in json but provide represents, Array of Strings: StringValue'}
