										optional
											String io_k8s_api_resource_v1alpha3_DeviceTaintRule_spec_taint_timeAdded_Time {doc 'Time is a wrapper around timeTime which supports correct marshaling to YAML and JSON  Wrappers are provided for many of the factory methods that the time package offers'}
