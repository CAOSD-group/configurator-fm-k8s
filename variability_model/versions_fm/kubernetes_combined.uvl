																									io_k8s_api_apps_v1_ReplicaSetList_items_spec_template_spec_volumes_projected_sources_downwardAPI_items_resourceFieldRef_divisor {doc 'Specifies the output format of the exposed resources, defaults to 1'}
																										alternative
