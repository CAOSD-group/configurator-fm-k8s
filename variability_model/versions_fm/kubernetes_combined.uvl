													io_k8s_api_admissionregistration_v1beta1_MutatingAdmissionPolicyBindingList_items_spec_matchResources_excludeResourceRules_apiVersions cardinality [1..*] {doc 'apiVersions is the API versions the resources belong to _*_ is all versions If _*_ is present, the length of the slice must be one Required'}
