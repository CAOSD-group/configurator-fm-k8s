																							io_k8s_api_batch_v1_CronJobList_items_spec_jobTemplate_spec_template_spec_initContainers_env_valueFrom_fileKeyRef {doc 'FileKeyRef selects a key of the env file Requires the EnvFiles feature gate to be enabled'}
