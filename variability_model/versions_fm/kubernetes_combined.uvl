			io_k8s_api_networking_v1_ServiceCIDR {doc 'ServiceCIDR defines a range of IP addresses using CIDR format (eg 19216800/24 or 2001:db2::/64) This range is used to allocate ClusterIPs to Service objects'}
				optional
					String io_k8s_api_networking_v1_ServiceCIDR_apiVersion {doc 'APIVersion defines the versioned schema of this representation of an object Servers should convert recognized schemas to the latest internal value, and may reject unrecognized values More info: https:_gitk8sio/community/contributors/devel/sig-architecture/api-conventionsmd#resources'}
