									io_k8s_api_core_v1_ResourceStatus_resources_health_Unknown {doc 'Specific value: Unknown'}
							String io_k8s_api_core_v1_ResourceStatus_resources_message {doc 'Message provides human-readable context for Health (eg ECC error count exceeded threshold) This field is populated by the kubelet when ResourceHealthStatusMessage is enabled if the DRA plugin returns a message, and is null otherwise'}
