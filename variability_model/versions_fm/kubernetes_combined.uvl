													io_k8s_api_apps_v1_ReplicaSet_spec_template_spec_volumes_azureFile {doc 'azureFile represents an Azure File Service mount on the host and bind mount to the pod Deprecated: AzureFile is deprecated All operations for the in-tree azureFile type are redirected to the filecsiazurecom CSI driver'}
