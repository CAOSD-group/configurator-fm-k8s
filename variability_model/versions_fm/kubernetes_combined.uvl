																alternative
																	io_k8s_api_apps_v1_StatefulSetList_items_spec_volumeClaimTemplates_status_conditions_status_Unknown {doc 'Specific value: Unknown'}
																	io_k8s_api_apps_v1_StatefulSetList_items_spec_volumeClaimTemplates_status_conditions_status_True {doc 'Specific value: True'}
																	io_k8s_api_apps_v1_StatefulSetList_items_spec_volumeClaimTemplates_status_conditions_status_False {doc 'Specific value: False'}
															String io_k8s_api_apps_v1_StatefulSetList_items_spec_volumeClaimTemplates_status_conditions_type {doc 'Type is the type of the condition More info: https:_kubernetesio/docs/reference/kubernetes-api/config-and-storage-resources/persistent-volume-claim-v1/#:~:text=set%20to%20%27ResizeStarted%27-,PersistentVolumeClaimCondition,-contains%20details%20about'}
														optional
