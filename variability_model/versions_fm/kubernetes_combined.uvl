																	String io_k8s_api_batch_v1_JobSpec_template_spec_initContainers_env_valueFrom_fileKeyRef_path {doc 'The path within the volume from which to select the file Must be relative and may not contain the __ path or start with __'}
																	String io_k8s_api_batch_v1_JobSpec_template_spec_initContainers_env_valueFrom_fileKeyRef_volumeName {doc 'The name of the volume mount containing the env file'}
