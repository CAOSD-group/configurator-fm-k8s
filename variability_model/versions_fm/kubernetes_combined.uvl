							Integer io_k8s_api_apiserverinternal_v1alpha1_StorageVersionStatus_conditions_observedGeneration {doc 'observedGeneration represents the metadatageneration that the condition was set based upon, if field is set'}
					io_k8s_api_apiserverinternal_v1alpha1_StorageVersionStatus_storageVersions cardinality [1..*] {doc 'storageVersions lists the reported versions per API server instance'}
