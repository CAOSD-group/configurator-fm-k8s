																optional
																	io_k8s_api_resource_v1_ResourceClaimList_items_status_allocation_nodeSelector_nodeSelectorTerms_matchExpressions_values cardinality [1..*] {doc 'An array of string values If the operator is In or NotIn, the values array must be non-empty If the operator is Exists or DoesNotExist, the values array must be empty If the operator is Gt or Lt, the values array must have a single element, which will be interpreted as an integer This array is replaced during a strategic merge patch'}
																		mandatory
																			String io_k8s_api_resource_v1_ResourceClaimList_items_status_allocation_nodeSelector_nodeSelectorTerms_matchExpressions_values_StringValue {doc 'Added String mandatory for complete structure Array in the model The modified is not in json but provide represents, Array of Strings: StringValue'}
															io_k8s_api_resource_v1_ResourceClaimList_items_status_allocation_nodeSelector_nodeSelectorTerms_matchFields cardinality [1..*] {doc 'A list of node selector requirements by node_s fields'}
