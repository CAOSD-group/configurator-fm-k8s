							io_k8s_api_core_v1_PhotonPersistentDiskVolumeSource_fsType_ntfs {doc 'Specific value: ntfs'}
							io_k8s_api_core_v1_PhotonPersistentDiskVolumeSource_fsType_xfs {doc 'Specific value: xfs'}
