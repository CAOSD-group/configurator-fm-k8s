											String io_k8s_api_resource_v1alpha3_DeviceTaintRuleList_items_status_conditions_message {doc 'message is a human readable message indicating details about the transition This may be an empty string'}
											String io_k8s_api_resource_v1alpha3_DeviceTaintRuleList_items_status_conditions_reason {doc 'reason contains a programmatic identifier indicating the reason for the condition_s last transition Producers of specific condition types may define expected values and meanings for this field, and whether the values are considered a guaranteed API The value should be a CamelCase string This field may not be empty'}
											io_k8s_api_resource_v1alpha3_DeviceTaintRuleList_items_status_conditions_status {doc 'status of the condition, one of True, False, Unknown'}
												alternative
													io_k8s_api_resource_v1alpha3_DeviceTaintRuleList_items_status_conditions_status_Unknown {doc 'Specific value: Unknown'}
													io_k8s_api_resource_v1alpha3_DeviceTaintRuleList_items_status_conditions_status_True {doc 'Specific value: True'}
													io_k8s_api_resource_v1alpha3_DeviceTaintRuleList_items_status_conditions_status_False {doc 'Specific value: False'}
											String io_k8s_api_resource_v1alpha3_DeviceTaintRuleList_items_status_conditions_type {doc 'type of condition in CamelCase or in fooexamplecom/CamelCase'}
										optional
											Integer io_k8s_api_resource_v1alpha3_DeviceTaintRuleList_items_status_conditions_observedGeneration {doc 'observedGeneration represents the metadatageneration that the condition was set based upon For instance, if metadatageneration is currently 12, but the statusconditions[x]observedGeneration is 9, the condition is out of date with respect to the current state of the instance'}
