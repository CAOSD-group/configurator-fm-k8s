														mandatory
															String io_k8s_api_resource_v1beta2_ResourceSliceSpec_devices_nodeSelector_nodeSelectorTerms_matchExpressions_values_StringValue {doc 'Added String mandatory for complete structure Array in the model The modified is not in json but provide represents, Array of Strings: StringValue'}
