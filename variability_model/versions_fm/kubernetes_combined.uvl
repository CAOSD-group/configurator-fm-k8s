													io_k8s_api_apps_v1_ReplicaSetSpec_template_spec_volumes_rbd_monitors cardinality [1..*] {doc 'monitors is a collection of Ceph monitors More info: https:_examplesk8sio/volumes/rbd/READMEmd#how-to-use-it'}
