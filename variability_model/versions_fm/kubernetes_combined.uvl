					String io_k8s_api_resource_v1_ResourceSliceSpec_partitionTypeAttribute {doc 'PartitionTypeAttribute names a string device attribute (by fully qualified name, eg gpuexamplecom/profile) whose value labels each device with its partition type, such as Full or Half for a MIG-style GPUWhen set, every partitionable device in the slice must carry the attribute and devices sharing a value must share the same ConsumesCounters cost'}
					io_k8s_api_resource_v1_ResourceSliceSpec_perDeviceNodeSelection {doc 'PerDeviceNodeSelection defines whether the access from nodes to resources in the pool is set on the ResourceSlice level or on each device If it is set to true, every device defined the ResourceSlice must specify this individuallyExactly one of NodeName, NodeSelector, AllNodes, and PerDeviceNodeSelection must be set'}
					io_k8s_api_resource_v1_ResourceSliceSpec_sharedCounters cardinality [1..*] {doc 'SharedCounters defines a list of counter sets, each of which has a name and a list of counters availableThe names of the counter sets must be unique in the ResourcePoolOnly one of Devices and SharedCounters can be set in a ResourceSliceThe maximum number of counter sets is 8'}
						mandatory
							io_k8s_api_resource_v1_ResourceSliceSpec_sharedCounters_counters cardinality [1..*] {doc 'Counters defines the set of counters for this CounterSet The name of each counter must be unique in that set and must be a DNS labelThe maximum number of counters is 32'}
