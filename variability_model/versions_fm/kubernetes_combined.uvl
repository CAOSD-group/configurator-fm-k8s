															io_k8s_api_apps_v1_StatefulSetList_items_spec_template_spec_volumes_storageos {doc 'storageOS represents a StorageOS volume attached and mounted on Kubernetes nodes Deprecated: StorageOS is deprecated and the in-tree storageos type is no longer supported'}
