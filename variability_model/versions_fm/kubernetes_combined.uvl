														mandatory
															String io_k8s_api_core_v1_PodTemplate_template_spec_ephemeralContainers_resources_claims_name {doc 'Name must match the name of one entry in podspecresourceClaims of the Pod where this field is used It makes that resource available inside a container'}
														optional
															String io_k8s_api_core_v1_PodTemplate_template_spec_ephemeralContainers_resources_claims_request {doc 'Request is the name chosen for a request in the referenced claim If empty, everything from the claim is made available, otherwise only the result of this request'}
