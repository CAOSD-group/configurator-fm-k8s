									io_k8s_api_discovery_v1_EndpointSlice_endpoints_conditions_serving {doc 'serving indicates that this endpoint is able to receive traffic, according to whatever system is managing the endpoint For endpoints backed by pods, the EndpointSlice controller will mark the endpoint as serving if the pod_s Ready condition is True A nil value should be interpreted as true'}
									io_k8s_api_discovery_v1_EndpointSlice_endpoints_conditions_terminating {doc 'terminating indicates that this endpoint is terminating A nil value should be interpreted as false'}
