							io_k8s_api_admissionregistration_v1_MutatingAdmissionPolicyBindingSpec_matchResources_resourceRules cardinality [1..*] {doc 'resourceRules describes what operations on what resources/subresources the ValidatingAdmissionPolicy matches The policy cares about an operation if it matches _any_ Rule'}
