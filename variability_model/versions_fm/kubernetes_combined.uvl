																		mandatory
																			String io_k8s_api_apps_v1_Deployment_spec_template_spec_containers_env_valueFrom_configMapKeyRef_key {doc 'The key to select from the ConfigMap_s Data field Keys in the BinaryData field are not currently propagated to container env vars'}
																		optional
