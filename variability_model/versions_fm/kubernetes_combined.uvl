											io_k8s_api_core_v1_PodList_items_status_ephemeralContainerStatuses_allocatedResourcesStatus cardinality [1..*] {doc 'AllocatedResourcesStatus represents the status of various resources allocated for this Pod'}
												mandatory
													io_k8s_api_core_v1_PodList_items_status_ephemeralContainerStatuses_allocatedResourcesStatus_name {doc 'Name of the resource Must be unique within the pod and in case of non-DRA resource, match one of the resources from the pod spec For DRA resources, the value must be claim:<claim_name>/<request> when containerresourcesclaims[*]request is set or claim:<claim_name> when containerresourcesclaims[*]request is empty For DRA-backed extended resources, claim:<claim_name>/<request> is used when the claim name and request name are recorded in podstatusextendedResourceClaimStatus When this status is reported about a container, the claim_name and request must match one of the claims of this container'}
														alternative
															io_k8s_api_core_v1_PodList_items_status_ephemeralContainerStatuses_allocatedResourcesStatus_name_claim_name {doc 'Specific value: claim_name'}
															io_k8s_api_core_v1_PodList_items_status_ephemeralContainerStatuses_allocatedResourcesStatus_name_request {doc 'Specific value: request'}
												optional
													io_k8s_api_core_v1_PodList_items_status_ephemeralContainerStatuses_allocatedResourcesStatus_resources cardinality [1..*] {doc 'List of unique resources health Each element in the list contains an unique resource ID and its health At a minimum, for the lifetime of a Pod, resource ID must uniquely identify the resource allocated to the Pod on the Node If other Pod on the same Node reports the status with the same resource ID, it must be the same resource they share See ResourceID type definition for a specific format it has in various use cases'}
														mandatory
															String io_k8s_api_core_v1_PodList_items_status_ephemeralContainerStatuses_allocatedResourcesStatus_resources_resourceID {doc 'ResourceID is the unique identifier of the resource See the ResourceID type for more information'}
														optional
															io_k8s_api_core_v1_PodList_items_status_ephemeralContainerStatuses_allocatedResourcesStatus_resources_health {doc 'Health of the resource can be one of: - Healthy: operates as normal - Unhealthy: reported unhealthy We consider this a temporary health issue              since we do not have a mechanism today to distinguish              temporary and permanent issues - Unknown: The status cannot be determined            For example, Device Plugin got unregistered and hasn_t been re-registered sinceIn future we may want to introduce the PermanentlyUnhealthy Status'}
																alternative
																	io_k8s_api_core_v1_PodList_items_status_ephemeralContainerStatuses_allocatedResourcesStatus_resources_health_Unhealthy {doc 'Specific value: Unhealthy'}
																	io_k8s_api_core_v1_PodList_items_status_ephemeralContainerStatuses_allocatedResourcesStatus_resources_health_Unknown {doc 'Specific value: Unknown'}
															String io_k8s_api_core_v1_PodList_items_status_ephemeralContainerStatuses_allocatedResourcesStatus_resources_message {doc 'Message provides human-readable context for Health (eg ECC error count exceeded threshold) This field is populated by the kubelet when ResourceHealthStatusMessage is enabled if the DRA plugin returns a message, and is null otherwise'}
											String io_k8s_api_core_v1_PodList_items_status_ephemeralContainerStatuses_containerID {doc 'ContainerID is the ID of the container in the format _<type>:_<container_id>_ Where type is a container runtime identifier, returned from Version call of CRI API (for example containerd)'}
											io_k8s_api_core_v1_PodList_items_status_ephemeralContainerStatuses_lastState {doc 'LastTerminationState holds the last termination state of the container to help debug container crashes and restarts This field is not populated if the container is still running and RestartCount is 0'}
