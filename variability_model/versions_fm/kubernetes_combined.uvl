													io_k8s_api_apps_v1_ReplicaSet_spec_template_spec_volumes_nfs {doc 'nfs represents an NFS mount on the host that shares a pod_s lifetime More info: https:_kubernetesio/docs/concepts/storage/volumes#nfs'}
														mandatory
