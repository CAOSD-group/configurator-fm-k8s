																						mandatory
																							io_k8s_api_batch_v1_CronJobList_items_spec_jobTemplate_spec_template_spec_ephemeralContainers_restartPolicyRules_exitCodes_operator {doc 'Represents the relationship between the container exit code(s) and the specified values Possible values are: - In: the requirement is satisfied if the container exit code is in the  set of specified values- NotIn: the requirement is satisfied if the container exit code is  not in the set of specified values'}
																								alternative
