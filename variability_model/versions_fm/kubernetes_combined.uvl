																		optional
																			String io_k8s_api_apps_v1_StatefulSet_spec_template_spec_containers_env_valueFrom_fieldRef_apiVersion {doc 'Version of the schema the FieldPath is written in terms of, defaults to v1'}
																	io_k8s_api_apps_v1_StatefulSet_spec_template_spec_containers_env_valueFrom_fileKeyRef {doc 'FileKeyRef selects a key of the env file Requires the EnvFiles feature gate to be enabled'}
																		mandatory
																			String io_k8s_api_apps_v1_StatefulSet_spec_template_spec_containers_env_valueFrom_fileKeyRef_key {doc 'The key within the env file An invalid key will prevent the pod from starting The keys defined within a source may consist of any printable ASCII characters except _=_ During Alpha stage of the EnvFiles feature gate, the key size is limited to 128 characters'}
																			String io_k8s_api_apps_v1_StatefulSet_spec_template_spec_containers_env_valueFrom_fileKeyRef_path {doc 'The path within the volume from which to select the file Must be relative and may not contain the __ path or start with __'}
