													Integer io_k8s_api_apps_v1_Deployment_spec_template_spec_ephemeralContainers_readinessProbe_failureThreshold {configKey 'failureThreshold', schema_type 'integer', schema_format 'int32', defaultValue 3, defaultValueSource 'description', doc 'Minimum consecutive failures for the probe to be considered failed after having succeeded. Defaults to 3. Minimum value is 1.'}
