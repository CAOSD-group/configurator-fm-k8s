													io_k8s_api_apps_v1_Deployment_spec_template_spec_volumes_iscsi_secretRef {configKey 'secretRef', schemaRef '#/definitions/io.k8s.api.core.v1.LocalObjectReference', doc 'secretRef is the CHAP Secret for iSCSI target and initiator authentication'}
