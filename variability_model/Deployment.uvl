											io_k8s_api_apps_v1_Deployment_spec_template_spec_ephemeralContainers_resources {configKey 'resources', schemaRef '#/definitions/io.k8s.api.core.v1.ResourceRequirements', doc 'Resources are not allowed for ephemeral containers. Ephemeral containers use spare resources already allocated to the pod.'}
