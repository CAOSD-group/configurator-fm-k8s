													io_k8s_api_apps_v1_Deployment_spec_template_spec_volumes_flexVolume_secretRef {configKey 'secretRef', schemaRef '#/definitions/io.k8s.api.core.v1.LocalObjectReference', doc 'secretRef is Optional: secretRef is reference to the secret object containing sensitive information to pass to the plugin scripts. This may be empty if no secret object is specified. If the secret object contains more than one secret, all secrets are passed to the plugin scripts.'}
