								optional
									String io_k8s_api_apps_v1_Deployment_status_conditions_lastTransitionTime_Time {serializationKind 'scalar', serializationRole 'value', doc 'Time is a wrapper around time.Time which supports correct marshaling to YAML and JSON. Wrappers are provided for many of the factory methods that the time package offers.'}
							io_k8s_api_apps_v1_Deployment_status_conditions_lastUpdateTime {configKey 'lastUpdateTime', schemaRef '#/definitions/io.k8s.apimachinery.pkg.apis.meta.v1.Time', doc 'The last time this condition was updated.'}
								optional
