											io_k8s_api_apps_v1_Deployment_spec_template_spec_volumes_persistentVolumeClaim {configKey 'persistentVolumeClaim', schemaRef '#/definitions/io.k8s.api.core.v1.PersistentVolumeClaimVolumeSource', doc 'persistentVolumeClaimVolumeSource represents a reference to a PersistentVolumeClaim in the same namespace. More info: https://kubernetes.io/docs/concepts/storage/persistent-volumes#persistentvolumeclaims'}
												mandatory
