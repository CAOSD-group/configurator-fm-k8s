											io_k8s_api_apps_v1_Deployment_spec_template_spec_affinity_podAntiAffinity {configKey 'podAntiAffinity', schemaRef '#/definitions/io.k8s.api.core.v1.PodAntiAffinity', doc 'Describes pod anti-affinity scheduling rules (e.g. avoid putting this pod in the same node, zone, etc. as some other pod(s)).'}
												optional
													io_k8s_api_apps_v1_Deployment_spec_template_spec_affinity_podAntiAffinity_preferredDuringSchedulingIgnoredDuringExecution cardinality [0..*] {configKey 'preferredDuringSchedulingIgnoredDuringExecution', serializationKind 'array', schema_type 'array', schemaItemsRef '#/definitions/io.k8s.api.core.v1.WeightedPodAffinityTerm', x_kubernetes_list_type 'atomic', doc 'The scheduler will prefer to schedule pods to nodes that satisfy the anti-affinity expressions specified by this field, but it may choose a node that violates one or more of the expressions. The node that is most preferred is the one with the greatest sum of weights, i.e. for each node that meets all of the scheduling requirements (resource request, requiredDuringScheduling anti-affinity expressions, etc.), compute a sum by iterating through the elements of this field and subtracting "weight" from the sum if the node has pods which matches the corresponding podAffinityTerm; the node(s) with the highest sum are the most preferred.'}
														mandatory
															io_k8s_api_apps_v1_Deployment_spec_template_spec_affinity_podAntiAffinity_preferredDuringSchedulingIgnoredDuringExecution_podAffinityTerm {configKey 'podAffinityTerm', schemaRef '#/definitions/io.k8s.api.core.v1.PodAffinityTerm', requiredSource 'schema', doc 'Required. A pod affinity term, associated with the corresponding weight.'}
																mandatory
