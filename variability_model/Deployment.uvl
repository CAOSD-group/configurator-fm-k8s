													io_k8s_api_apps_v1_Deployment_spec_template_spec_ephemeralContainers_livenessProbe_grpc {configKey 'grpc', schemaRef '#/definitions/io.k8s.api.core.v1.GRPCAction', doc 'GRPC specifies a GRPC HealthCheckRequest.'}
