												optional
													String io_k8s_api_apps_v1_Deployment_spec_template_spec_initContainers_env_value {configKey 'value', schema_type 'string', defaultValue '\u0000', defaultValueSource 'description', doc 'Variable references $(VAR_NAME) are expanded using the previously defined environment variables in the container and any service environment variables. If a variable cannot be resolved, the reference in the input string will be unchanged. Double $$ are reduced to a single $, which allows for escaping the $(VAR_NAME) syntax: i.e. "$$(VAR_NAME)" will produce the string literal "$(VAR_NAME)". Escaped references will never be expanded, regardless of whether the variable exists or not. Defaults to "".'}
