											String io_k8s_api_apps_v1_Deployment_spec_template_spec_ephemeralContainers_restartPolicy {configKey 'restartPolicy', schema_type 'string', doc 'Restart policy for the container to manage the restart behavior of each container within a pod. You cannot set this field on ephemeral containers.'}
											io_k8s_api_apps_v1_Deployment_spec_template_spec_ephemeralContainers_restartPolicyRules cardinality [0..*] {configKey 'restartPolicyRules', serializationKind 'array', schema_type 'array', schemaItemsRef '#/definitions/io.k8s.api.core.v1.ContainerRestartRule', x_kubernetes_list_type 'atomic', doc 'Represents a list of rules to be checked to determine if the container should be restarted on exit. You cannot set this field on ephemeral containers.'}
												mandatory
													String io_k8s_api_apps_v1_Deployment_spec_template_spec_ephemeralContainers_restartPolicyRules_action {configKey 'action', schema_type 'string', requiredSource 'schema', doc 'Specifies the action taken on a container exit if the requirements are satisfied. The only possible value is "Restart" to restart the container.'}
												optional
													io_k8s_api_apps_v1_Deployment_spec_template_spec_ephemeralContainers_restartPolicyRules_exitCodes {configKey 'exitCodes', schemaRef '#/definitions/io.k8s.api.core.v1.ContainerRestartRuleOnExitCodes', doc 'Represents the exit codes to check on container exits.'}
														mandatory
