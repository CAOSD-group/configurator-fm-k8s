											io_k8s_api_apps_v1_Deployment_spec_template_spec_containers_resources {configKey 'resources', schemaRef '#/definitions/io.k8s.api.core.v1.ResourceRequirements', doc 'Compute Resources required by this container. Cannot be updated. More info: https://kubernetes.io/docs/concepts/configuration/manage-resources-containers/'}
