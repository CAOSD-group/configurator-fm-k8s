											io_k8s_api_apps_v1_Deployment_spec_template_spec_affinity_podAffinity {configKey 'podAffinity', schemaRef '#/definitions/io.k8s.api.core.v1.PodAffinity', doc 'Describes pod affinity scheduling rules (e.g. co-locate this pod in the same node, zone, etc. as some other pod(s)).'}
												optional
													io_k8s_api_apps_v1_Deployment_spec_template_spec_affinity_podAffinity_preferredDuringSchedulingIgnoredDuringExecution cardinality [0..*] {configKey 'preferredDuringSchedulingIgnoredDuringExecution', serializationKind 'array', schema_type 'array', schemaItemsRef '#/definitions/io.k8s.api.core.v1.WeightedPodAffinityTerm', x_kubernetes_list_type 'atomic', doc 'The scheduler will prefer to schedule pods to nodes that satisfy the affinity expressions specified by this field, but it may choose a node that violates one or more of the expressions. The node that is most preferred is the one with the greatest sum of weights, i.e. for each node that meets all of the scheduling requirements (resource request, requiredDuringScheduling affinity expressions, etc.), compute a sum by iterating through the elements of this field and adding "weight" to the sum if the node has pods which matches the corresponding podAffinityTerm; the node(s) with the highest sum are the most preferred.'}
														mandatory
															io_k8s_api_apps_v1_Deployment_spec_template_spec_affinity_podAffinity_preferredDuringSchedulingIgnoredDuringExecution_podAffinityTerm {configKey 'podAffinityTerm', schemaRef '#/definitions/io.k8s.api.core.v1.PodAffinityTerm', requiredSource 'schema', doc 'Required. A pod affinity term, associated with the corresponding weight.'}
																mandatory
																	String io_k8s_api_apps_v1_Deployment_spec_template_spec_affinity_podAffinity_preferredDuringSchedulingIgnoredDuringExecution_podAffinityTerm_topologyKey {configKey 'topologyKey', schema_type 'string', requiredSource 'schema', doc 'This pod should be co-located (affinity) or not co-located (anti-affinity) with the pods matching the labelSelector in the specified namespaces, where co-located is defined as running on a node whose value of the label with key topologyKey matches that of any node on which any of the selected pods is running. Empty topologyKey is not allowed.'}
																optional
																	io_k8s_api_apps_v1_Deployment_spec_template_spec_affinity_podAffinity_preferredDuringSchedulingIgnoredDuringExecution_podAffinityTerm_labelSelector {configKey 'labelSelector', schemaRef '#/definitions/io.k8s.apimachinery.pkg.apis.meta.v1.LabelSelector', doc 'A label query over a set of resources, in this case pods. If it’s null, this PodAffinityTerm matches with no Pods.'}
																		optional
																			io_k8s_api_apps_v1_Deployment_spec_template_spec_affinity_podAffinity_preferredDuringSchedulingIgnoredDuringExecution_podAffinityTerm_labelSelector_matchExpressions cardinality [0..*] {configKey 'matchExpressions', serializationKind 'array', schema_type 'array', schemaItemsRef '#/definitions/io.k8s.apimachinery.pkg.apis.meta.v1.LabelSelectorRequirement', x_kubernetes_list_type 'atomic', doc 'matchExpressions is a list of label selector requirements. The requirements are ANDed.'}
																				mandatory
