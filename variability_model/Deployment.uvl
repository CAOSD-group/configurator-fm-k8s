															io_k8s_api_apps_v1_Deployment_spec_template_spec_volumes_projected_sources_configMap {configKey 'configMap', schemaRef '#/definitions/io.k8s.api.core.v1.ConfigMapProjection', doc 'configMap information about the configMap data to project'}
																optional
																	io_k8s_api_apps_v1_Deployment_spec_template_spec_volumes_projected_sources_configMap_items cardinality [0..*] {configKey 'items', serializationKind 'array', schema_type 'array', schemaItemsRef '#/definitions/io.k8s.api.core.v1.KeyToPath', x_kubernetes_list_type 'atomic', doc 'items if unspecified, each key-value pair in the Data field of the referenced ConfigMap will be projected into the volume as a file whose name is the key and content is the value. If specified, the listed keys will be projected into the specified paths, and unlisted keys will not be present. If a key is specified which is not present in the ConfigMap, the volume setup will error unless it is marked optional. Paths must be relative and may not contain the ’..’ path or start with ’..’.'}
