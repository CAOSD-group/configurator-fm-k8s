																						mandatory
																							String io_k8s_api_apps_v1_Deployment_spec_template_spec_volumes_projected_sources_clusterTrustBundle_labelSelector_matchExpressions_values_StringValue {serializationRole 'arrayItem', doc 'Synthetic value for OpenAPI array; schema item type: string'}
																			io_k8s_api_apps_v1_Deployment_spec_template_spec_volumes_projected_sources_clusterTrustBundle_labelSelector_matchLabels cardinality [0..*] {configKey 'matchLabels', serializationKind 'map', schema_type 'object', schemaAdditionalPropertiesType 'string', doc 'matchLabels is a map of {key,value} pairs. A single {key,value} in the matchLabels map is equivalent to an element of matchExpressions, whose key field is "key", the operator is "In", and the values array contains only "value". The requirements are ANDed.'}
																				mandatory
