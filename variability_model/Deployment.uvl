														optional
															String io_k8s_api_apps_v1_Deployment_spec_template_spec_ephemeralContainers_livenessProbe_grpc_mode {configKey 'mode', schema_type 'string', doc 'mode specifies the connection mode for the gRPC health probe. Set to "TLS" to use TLS without certificate verification. Set to "Plaintext" to use a plaintext (insecure) connection explicitly. If not specified, the probe uses a plaintext (insecure) connection.'}
